	Drag = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
}

local function Tween(inst, info, props)
	local tween = TweenService:Create(inst, info, props)
	tween:Play()
	return tween
end

local function Animate(inst, info, props, instant)
	if instant then
		for k, v in pairs(props) do
			inst[k] = v
		end
	else
		Tween(inst, info, props)
	end
end

-- ───────────────────────────── Small helpers ─────────────────────────────

local function Create(class, props, children)
	local inst = Instance.new(class)
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function CornerPx(parent, radius)
	return Create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function CornerFull(parent)
	return Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

local function StrokeOf(parent, color, transparency, thickness)
	return Create("UIStroke", {
		Color = color,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function PaddingOf(parent, left, top, right, bottom)
	return Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function ListOf(parent, padding)
	return Create("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

local function NewLabel(props)
	local p = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "",
	}
	for k, v in pairs(props) do
		p[k] = v
	end
	return Create("TextLabel", p)
end

local function Darken(color, factor)
	local h, s, v = Color3.toHSV(color)
	return Color3.fromHSV(h, s, v * factor)
end

local function Decimals(n)
	local frac = tostring(n):match("%.(%d+)")
	return frac and #frac or 0
end

local function RoundTo(n, inc)
	if inc <= 0 then
		return n
	end
	return math.floor(n / inc + 0.5) * inc
end

local function Fix(n, dec)
	return tonumber(string.format("%." .. dec .. "f", n))
end

local function SafeCall(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[BeeLib] callback error: " .. tostring(err))
	end
end

local function BindName(bind)
	if not bind then
		return "None"
	end
	if bind == Enum.UserInputType.MouseButton2 then
		return "MB2"
	elseif bind == Enum.UserInputType.MouseButton3 then
		return "MB3"
	end
	return bind.Name
end

local function ParseBind(value)
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) ~= "string" then
		return nil
	end
	local ok, result = pcall(function()
		return Enum.KeyCode[value]
	end)
	if ok and result then
		return result
	end
	ok, result = pcall(function()
		return Enum.UserInputType[value]
	end)
	if ok and result then
		return result
	end
	return nil
end

local function MountGui(gui)
	local mounted = false
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and typeof(hui) == "Instance" then
		mounted = pcall(function()
			gui.Parent = hui
		end)
	end
	if not mounted then
		mounted = pcall(function()
			gui.Parent = game:GetService("CoreGui")
		end)
	end
	if not mounted or not gui.Parent then
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
end

