	for k, v in pairs(DefaultTheme) do
		theme[k] = v
	end
	if opts.Accent then
		theme.Accent = opts.Accent
		theme.AccentDark = Darken(opts.Accent, 0.78)
	end
	if opts.Theme then
		for k, v in pairs(opts.Theme) do
			theme[k] = v
		end
	end

	local win = setmetatable({
		Theme = theme,
		Tabs = {},
		ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift,
		_conns = {},
		_visible = false,
		_ready = false,
		_destroyed = false,
		_closing = false,
