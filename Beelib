	MakeDraggable(win, bubble, bubble, bubbleDrag)
	bubble.Activated:Connect(function()
		if bubbleDrag.moved < 8 then
			win:SetVisible(true)
		end
	end)
	win._bubble, win._bubbleScale = bubble, bubbleScale

	-- Toggle key
	win:_connect(UIS.InputBegan, function(input, processed)
		if processed or Bee._listening or not win._ready then
			return
		end
		if input.KeyCode == win.ToggleKey then
			win:SetVisible(not win._visible)
		end
	end)

	-- Intro card (a small centered card - no full-screen dimming)
	local function RunIntro()
		local card = Create("Frame", {
			Name = "Intro",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(320, 180),
			BackgroundColor3 = theme.Background,
			BorderSizePixel = 0,
			Parent = gui,
		})
		CornerPx(card, 14)
		StrokeOf(card, theme.Accent, 0.3, 1.5)
		local cardScale = Create("UIScale", { Scale = 0.6, Parent = card })
		Tween(cardScale, EASE.Pop, { Scale = 1 })

		local flower = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, 58),
			Size = UDim2.fromOffset(120, 100),
			BackgroundTransparency = 1,
			Parent = card,
		})
		local d, gap = 30, 4
		local dist = d * 0.866 + gap
		for i = 0, 6 do
			local px, py = 0, 0
			if i > 0 then
				local ang = math.rad((i - 1) * 60)
				px, py = math.cos(ang) * dist, -math.sin(ang) * dist
			end
			local hx = Hex(flower, d, i == 0 and theme.Accent or theme.AccentDark)
			hx.Position = UDim2.new(0.5, px, 0.5, py)
			local sc = Create("UIScale", { Scale = 1, Parent = hx })
			TweenService:Create(
				sc,
				TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, i * 0.12),
				{ Scale = 0.55 }
			):Play()
		end

		local bee = BuildBee(card, 46)
		bee.AnchorPoint = Vector2.new(0.5, 0.5)
		bee.Position = UDim2.new(0.5, 0, 0, 58)
		TweenService:Create(
			bee,
			TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Position = UDim2.new(0.5, 0, 0, 50) }
		):Play()

		NewLabel({
			Position = UDim2.fromOffset(0, 112),
			Size = UDim2.new(1, 0, 0, 24),
			Text = opts.Title or "BeeHive",
			Font = Enum.Font.GothamBold,
			TextSize = 20,
			TextColor3 = theme.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = card,
		})
		local status = NewLabel({
			Position = UDim2.fromOffset(0, 136),
			Size = UDim2.new(1, 0, 0, 16),
			Text = "",
			TextSize = 12,
			TextColor3 = theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = card,
		})
		local barBack = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 160),
			Size = UDim2.fromOffset(220, 6),
			BackgroundColor3 = theme.Element,
			BorderSizePixel = 0,
			Parent = card,
		})
		CornerFull(barBack)
		local barFill = Create("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = barBack,
		})
		CornerFull(barFill)
		Create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, theme.Accent),
				ColorSequenceKeypoint.new(1, theme.AccentDark),
			}),
			Parent = barFill,
		})

		local steps = opts.IntroSteps
			or { "Waking up the hive...", "Gathering nectar...", "Making honey...", "Ready to buzz!" }
		local stepTime = opts.IntroStepTime or 0.45
		for i, text in ipairs(steps) do
			if win._destroyed then
				return
			end
			status.Text = text
			Tween(barFill, TweenInfo.new(stepTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.fromScale(i / #steps, 1),
			})
			task.wait(stepTime)
		end
		task.wait(0.15)
		Tween(cardScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 })
		task.wait(0.35)
		card:Destroy()
		if not win._destroyed then
			win._ready = true
			win:SetVisible(true)
		end
	end

	if opts.Intro == false then
		win._ready = true
		task.defer(function()
			win:SetVisible(true)
		end)
	else
		task.spawn(RunIntro)
	end

	return win
end

function Window:SetVisible(state)
	if self._destroyed or state == self._visible then
		return
	end
	self._visible = state
	if state then
		self._main.Visible = true
		Tween(self._scale, EASE.Pop, { Scale = 1 })
		Tween(self._canvas, EASE.Smooth, { GroupTransparency = 0 })
		Tween(self._mainStroke, EASE.Smooth, { Transparency = 0.35 })
		if self._bubble.Visible then
			local t = Tween(self._bubbleScale, EASE.Fast, { Scale = 0 })
			t.Completed:Connect(function()
				if self._visible then
					self._bubble.Visible = false
				end
			end)
		end
	else
		Tween(self._scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.8 })
		local t = Tween(self._canvas, EASE.Fast, { GroupTransparency = 1 })
		Tween(self._mainStroke, EASE.Fast, { Transparency = 1 })
		t.Completed:Connect(function()
			if not self._visible then
				self._main.Visible = false
			end
		end)
		if self._opts.Bubble ~= false and not self._closing then
			self._bubble.Visible = true
			Tween(self._bubbleScale, EASE.Pop, { Scale = 1 })
		end
	end
end

function Window:Toggle()
	self:SetVisible(not self._visible)
end

function Window:SetToggleKey(key)
	local bind = ParseBind(key)
	if bind then
		self.ToggleKey = bind
	end
end

function Window:Close()
	if self._destroyed or self._closing then
		return
	end
	self._closing = true
	self:SetVisible(false)
	SafeCall(self._opts.OnClose)
	task.delay(0.4, function()
		self:Destroy()
	end)
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	for _, conn in ipairs(self._conns) do
		conn:Disconnect()
	end
	for flag, opt in pairs(Bee.Options) do
		if opt._window == self then
			Bee.Options[flag] = nil
			Bee.Flags[flag] = nil
		end
	end
	local idx = table.find(Bee.Windows, self)
	if idx then
		table.remove(Bee.Windows, idx)
	end
	if self.Gui then
		self.Gui:Destroy()
	end
end

function Window:Notify(opts)
	if self._destroyed then
		return
	end
	if type(opts) == "string" then
		opts = { Content = opts }
	end
	opts = opts or {}
	local theme = self.Theme

	local kind = string.lower(opts.Type or "info")
	local color = (kind == "success" and theme.Good)
		or (kind == "warning" and theme.Warn)
		or (kind == "error" and theme.Bad)
		or theme.Accent
	local duration = opts.Duration or 4

	self._notifCount = (self._notifCount or 0) + 1
	local wrapper = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = self._notifCount,
		Parent = self._notifHolder,
	})
	local card = Create("Frame", {
		Position = UDim2.new(1, 60, 0, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Topbar,
		BorderSizePixel = 0,
		Parent = wrapper,
	})
	CornerPx(card, 10)
	StrokeOf(card, color, 0.35, 1)

	local body = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	PaddingOf(body, 12, 10, 12, 10)
	ListOf(body, 4)

	NewLabel({
		Text = opts.Title or "BeeHive",
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = color,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		LayoutOrder = 1,
		Parent = body,
	})
	if opts.Content then
		NewLabel({
			Text = opts.Content,
			TextSize = 13,
			TextColor3 = theme.Text,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			LayoutOrder = 2,
			Parent = body,
		})
	end
	local bar = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		Parent = body,
	})
	CornerFull(bar)

	Tween(card, EASE.Pop, { Position = UDim2.new(0, 0, 0, 0) })
	Tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 3) })

	local dismissed = false
	local function dismiss()
		if dismissed then
			return
		end
		dismissed = true
		local t = Tween(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Position = UDim2.new(1, 60, 0, 0),
		})
		t.Completed:Connect(function()
			if not wrapper.Parent then
				return
			end
			local h = wrapper.AbsoluteSize.Y
			wrapper.AutomaticSize = Enum.AutomaticSize.None
			wrapper.Size = UDim2.new(1, 0, 0, h)
			local shrink = Tween(wrapper, EASE.Smooth, { Size = UDim2.new(1, 0, 0, 0) })
			shrink.Completed:Connect(function()
				wrapper:Destroy()
			end)
		end)
	end
	task.delay(duration, dismiss)
end

function Bee:Notify(opts)
	local win = self.Windows[#self.Windows]
	if win then
		win:Notify(opts)
	end
end

function Bee:Destroy()
	for i = #self.Windows, 1, -1 do
		self.Windows[i]:Destroy()
	end
end

