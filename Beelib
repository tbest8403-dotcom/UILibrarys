function Window:AddTab(opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}
	local win = self
	local theme = self.Theme
	local name = opts.Name or "Tab"

	local tab = setmetatable({ _window = win, Name = name, _order = 0 }, Tab)

	local btn = Create("TextButton", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = theme.Element,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		LayoutOrder = #self.Tabs + 1,
		Parent = self._tabList,
	})
	CornerPx(btn, 8)
	local bar = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(3, 0),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = btn,
	})
	CornerFull(bar)

	local textX = 14
	if opts.Icon then
		NewLabel({
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.fromOffset(22, 34),
			Text = opts.Icon,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = btn,
		})
		textX = 38
	end
	local text = NewLabel({
		Position = UDim2.fromOffset(textX, 0),
		Size = UDim2.new(1, -textX - 6, 1, 0),
		Text = name,
		TextColor3 = theme.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = btn,
	})

	local group = Create("CanvasGroup", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = self._content,
	})
	local page = Create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = group,
	})
	ListOf(page, 8)
	PaddingOf(page, 12, 14, 14, 14)

	tab._btn, tab._text, tab._bar, tab._group, tab._page, tab._container = btn, text, bar, group, page, page

	btn.MouseEnter:Connect(function()
		if win._current ~= tab then
			Tween(btn, EASE.Fast, { BackgroundTransparency = 0.6 })
			Tween(text, EASE.Fast, { TextColor3 = theme.Text })
		end
	end)
	btn.MouseLeave:Connect(function()
		if win._current ~= tab then
			Tween(btn, EASE.Fast, { BackgroundTransparency = 1 })
			Tween(text, EASE.Fast, { TextColor3 = theme.SubText })
		end
	end)
	btn.Activated:Connect(function()
		win:SelectTab(tab)
	end)

	table.insert(self.Tabs, tab)
	if not self._current then
		self:SelectTab(tab, true)
	end
	return tab
end

function Window:SelectTab(tab, instant)
	if self._current == tab then
		return
	end
	local theme = self.Theme
	local old = self._current
	self._current = tab

	if old then
		Tween(old._btn, EASE.Fast, { BackgroundTransparency = 1 })
		Tween(old._text, EASE.Fast, { TextColor3 = theme.SubText })
		Tween(old._bar, EASE.Smooth, { Size = UDim2.fromOffset(3, 0) })
		local t = Tween(old._group, EASE.Fast, { GroupTransparency = 1 })
		t.Completed:Connect(function()
			if self._current ~= old then
				old._group.Visible = false
			end
		end)
	end

	tab._group.Visible = true
	if instant then
		tab._group.GroupTransparency = 0
		tab._group.Position = UDim2.fromOffset(0, 0)
	else
		tab._group.GroupTransparency = 1
		tab._group.Position = UDim2.fromOffset(0, 18)
		Tween(tab._group, EASE.Smooth, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
	end
	Animate(tab._btn, EASE.Fast, { BackgroundTransparency = 0 }, instant)
	Animate(tab._text, EASE.Fast, { TextColor3 = theme.Accent }, instant)
	Animate(tab._bar, EASE.Pop, { Size = UDim2.fromOffset(3, 18) }, instant)
end

function Tab:Select()
	self._window:SelectTab(self)
end

-- ───────────────────────────── Element helpers ─────────────────────────────

local function NextOrder(owner)
	owner._order = (owner._order or 0) + 1
	return owner._order
end

local function BaseElement(owner, height)
	local theme = owner._window.Theme
	local frame = Create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		LayoutOrder = NextOrder(owner),
		Parent = owner._container,
	})
	CornerPx(frame, 8)
	local stroke = StrokeOf(frame, theme.Stroke, 0.5, 1)
	return frame, stroke
end

local function Hover(trigger, frame, stroke, theme)
	trigger.MouseEnter:Connect(function()
		Tween(frame, EASE.Fast, { BackgroundColor3 = theme.ElementHover })
		Tween(stroke, EASE.Fast, { Transparency = 0.1 })
	end)
	trigger.MouseLeave:Connect(function()
		Tween(frame, EASE.Fast, { BackgroundColor3 = theme.Element })
		Tween(stroke, EASE.Fast, { Transparency = 0.5 })
	end)
end

local function Overlay(parent)
	return Create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = parent,
	})
end

local function IsPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

