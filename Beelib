-- A hexagon made of three rotated rectangles. `d` = point-to-point height.
local function Hex(parent, d, color)
	local holder = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(d, d),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	for _, rot in ipairs({ 0, 60, 120 }) do
		Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(d * 0.866, d * 0.5),
			Rotation = rot,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = holder,
		})
	end
	return holder
end

-- ───────────────────────────── Classes ─────────────────────────────

local Window = {}
Window.__index = Window

local Elements = {}
Elements.__index = Elements

local Tab = setmetatable({}, { __index = Elements })
Tab.__index = Tab

local ObjectMethods = {}
ObjectMethods.__index = ObjectMethods

function ObjectMethods:Get()
	return self.Value
end

function ObjectMethods:OnChanged(fn)
	table.insert(self._listeners, fn)
	return self
end

function ObjectMethods:SetVisible(state)
	if self._frame then
		self._frame.Visible = state and true or false
	end
end

function ObjectMethods:Destroy()
	if self.Flag then
		Bee.Options[self.Flag] = nil
		Bee.Flags[self.Flag] = nil
	end
	if self._frame then
		self._frame:Destroy()
	end
end

local function NewObject(owner, kind, opts, frame)
	return setmetatable({
		Type = kind,
		Callback = opts.Callback,
		_listeners = {},
		_window = owner._window,
		_frame = frame,
	}, ObjectMethods)
end

local function Register(obj, flag)
	if flag then
		obj.Flag = flag
		Bee.Flags[flag] = obj.Value
		Bee.Options[flag] = obj
	end
end

local function Commit(obj, ...)
	if obj.Flag then
		Bee.Flags[obj.Flag] = obj.Value
	end
	SafeCall(obj.Callback, ...)
	for _, fn in ipairs(obj._listeners) do
		SafeCall(fn, ...)
	end
end

function Window:_connect(signal, fn)
	local conn = signal:Connect(fn)
	table.insert(self._conns, conn)
	return conn
end

local function MakeDraggable(win, handle, target, state)
	local dragging = false
	local dragStart, startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
			if state then
				state.moved = 0
			end
		end
	end)

	win:_connect(UIS.InputChanged, function(input)
		if
			dragging
			and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
		then
			local delta = input.Position - dragStart
			if state then
				state.moved = math.max(state.moved, delta.Magnitude)
			end
			Tween(target, EASE.Drag, {
				Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				),
			})
		end
	end)

	win:_connect(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

