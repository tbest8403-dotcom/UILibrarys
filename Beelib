function Elements:AddToggle(opts)
	opts = opts or {}
	local theme = self._window.Theme
	local frame, stroke = BaseElement(self, 38)

	NewLabel({
		Text = opts.Name or "Toggle",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -72, 1, 0),
		TextColor3 = theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local track = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(42, 22),
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		Parent = frame,
	})
	CornerFull(track)
	local trackStroke = StrokeOf(track, theme.Stroke, 0.2, 1)
	local knob = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = theme.SubText,
		BorderSizePixel = 0,
		Parent = track,
	})
	CornerFull(knob)

	local btn = Overlay(frame)
	Hover(btn, frame, stroke, theme)

	local obj = NewObject(self, "Toggle", opts, frame)

	function obj:Set(value, silent, instant)
		value = value and true or false
		local changed = self.Value ~= value
		self.Value = value
		Animate(track, EASE.Fast, { BackgroundColor3 = value and theme.Accent or theme.Background }, instant)
		Animate(trackStroke, EASE.Fast, { Color = value and theme.Accent or theme.Stroke }, instant)
		Animate(knob, EASE.Pop, {
			Position = value and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = value and theme.OnAccent or theme.SubText,
		}, instant)
		if self.Flag then
			Bee.Flags[self.Flag] = value
		end
		if changed and not silent then
			Commit(self, value)
		end
	end

	btn.Activated:Connect(function()
		obj:Set(not obj.Value)
	end)

	obj:Set(opts.Default, true, true)
	Register(obj, opts.Flag)
	return obj
end

-- ───────────────────────────── Slider ─────────────────────────────

function Elements:AddSlider(opts)
	opts = opts or {}
	local win = self._window
	local theme = win.Theme
	local min, max = opts.Min or 0, opts.Max or 100
	local inc = opts.Increment or 1
	local suffix = opts.Suffix or ""
	local dec = Decimals(inc)
	local page = self._page

	local frame, stroke = BaseElement(self, 54)

	NewLabel({
		Text = opts.Name or "Slider",
		Position = UDim2.fromOffset(12, 7),
		Size = UDim2.new(1, -110, 0, 18),
		TextColor3 = theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local valueLabel = NewLabel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 7),
		Size = UDim2.fromOffset(96, 18),
		Text = "",
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})

	local track = Create("Frame", {
		Position = UDim2.new(0, 12, 0, 35),
		Size = UDim2.new(1, -24, 0, 8),
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		Parent = frame,
	})
	CornerFull(track)
	StrokeOf(track, theme.Stroke, 0.3, 1)
	local fill = Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	})
	CornerFull(fill)
	Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.AccentDark),
			ColorSequenceKeypoint.new(1, theme.Accent),
		}),
		Parent = fill,
	})
	local knob = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	})
	CornerFull(knob)
	StrokeOf(knob, theme.OnAccent, 0.2, 2)

	local btn = Overlay(frame)
	Hover(btn, frame, stroke, theme)

	local obj = NewObject(self, "Slider", opts, frame)
	obj.Min, obj.Max = min, max

	function obj:Set(value, silent, instant)
		value = tonumber(value) or self.Value or min
		value = Fix(math.clamp(RoundTo(value - min, inc) + min, min, max), dec)
		local pct = (max == min) and 0 or (value - min) / (max - min)
		local changed = self.Value ~= value
		self.Value = value
		valueLabel.Text = tostring(value) .. suffix
		Animate(fill, EASE.Drag, { Size = UDim2.fromScale(pct, 1) }, instant)
		Animate(knob, EASE.Drag, { Position = UDim2.new(pct, 0, 0.5, 0) }, instant)
		if self.Flag then
			Bee.Flags[self.Flag] = value
		end
		if changed and not silent then
			Commit(self, value)
		end
	end

	local function fromX(x)
		local pct = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + (max - min) * pct)
	end

	local dragging = false
	btn.InputBegan:Connect(function(input)
		if IsPress(input) then
			dragging = true
			if page then
				page.ScrollingEnabled = false
			end
			Tween(knob, EASE.Fast, { Size = UDim2.fromOffset(18, 18) })
			fromX(input.Position.X)
		end
	end)
	win:_connect(UIS.InputChanged, function(input)
		if dragging and IsMove(input) then
			fromX(input.Position.X)
		end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if dragging and IsPress(input) then
			dragging = false
			if page then
				page.ScrollingEnabled = true
			end
			Tween(knob, EASE.Pop, { Size = UDim2.fromOffset(14, 14) })
		end
	end)

	obj:Set(opts.Default or min, true, true)
	Register(obj, opts.Flag)
	return obj
end

-- ───────────────────────────── Dropdown ─────────────────────────────

function Elements:AddDropdown(opts)
	opts = opts or {}
	local theme = self._window.Theme
	local frame, stroke = BaseElement(self, 38)
	frame.ClipsDescendants = true

	local obj = NewObject(self, "Dropdown", opts, frame)
	obj.Multi = opts.Multi == true
	obj.Options = opts.Options or opts.Values or {}
	obj._set = {}

	local isOpen = false
	local buttons = {}

	local head = Overlay(frame)
	head.Size = UDim2.new(1, 0, 0, 38)
	Hover(head, frame, stroke, theme)
	NewLabel({
		Text = opts.Name or "Dropdown",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.5, -12, 1, 0),
		TextColor3 = theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = head,
	})
	local valueLabel = NewLabel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -32, 0, 0),
		Size = UDim2.new(0.5, -36, 1, 0),
		Text = "None",
		TextSize = 13,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = head,
	})
	local arrow = NewLabel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -18, 0, 19),
		Size = UDim2.fromOffset(14, 14),
		Text = "▼",
		TextSize = 10,
		TextColor3 = theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = head,
	})

	local list = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 46),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = frame,
	})
	ListOf(list, 4)

	local function listHeight()
		return math.min(math.max(#obj.Options * 30 - 4, 0), 150)
	end

	local function isSelected(name)
		if obj.Multi then
			return obj._set[name] == true
		end
		return obj.Value == name
	end

	local function updateText()
		if obj.Multi then
			if #obj.Value == 0 then
				valueLabel.Text = "None"
			else
				local names = {}
				for _, v in ipairs(obj.Value) do
					table.insert(names, tostring(v))
				end
				valueLabel.Text = table.concat(names, ", ")
			end
		else
			valueLabel.Text = obj.Value ~= nil and tostring(obj.Value) or "None"
		end
	end

	local function paint()
		for name, b in pairs(buttons) do
			local sel = isSelected(name)
			Tween(b.btn, EASE.Fast, { BackgroundTransparency = sel and 0.15 or 1 })
			Tween(b.label, EASE.Fast, { TextColor3 = sel and theme.Accent or theme.Text })
			Tween(b.dot, EASE.Pop, { Size = sel and UDim2.fromOffset(8, 8) or UDim2.fromOffset(0, 0) })
		end
	end

	local function build()
		for _, b in pairs(buttons) do
			b.btn:Destroy()
		end
		buttons = {}
		for i, name in ipairs(obj.Options) do
			local b = Create("TextButton", {
				Name = tostring(name),
				Size = UDim2.new(1, -6, 0, 26),
				BackgroundColor3 = theme.ElementHover,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				BorderSizePixel = 0,
				LayoutOrder = i,
				Parent = list,
			})
			CornerPx(b, 6)
			local label = NewLabel({
				Text = tostring(name),
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -34, 1, 0),
				TextSize = 13,
				TextColor3 = theme.Text,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = b,
			})
			local dot = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				Size = UDim2.fromOffset(0, 0),
				BackgroundColor3 = theme.Accent,
				BorderSizePixel = 0,
				Parent = b,
			})
			CornerFull(dot)
			buttons[name] = { btn = b, label = label, dot = dot }

			b.MouseEnter:Connect(function()
				if not isSelected(name) then
					Tween(b, EASE.Fast, { BackgroundTransparency = 0.6 })
				end
			end)
			b.MouseLeave:Connect(function()
				Tween(b, EASE.Fast, { BackgroundTransparency = isSelected(name) and 0.15 or 1 })
			end)
			b.Activated:Connect(function()
				if obj.Multi then
					local arr, found = {}, false
					for _, v in ipairs(obj.Value) do
						if v == name then
							found = true
						else
							table.insert(arr, v)
						end
					end
					if not found then
						table.insert(arr, name)
					end
					obj:Set(arr)
				else
					obj:Set(name)
					if not opts.KeepOpen then
						obj:Toggle(false)
					end
				end
			end)
		end
	end

	function obj:Set(value, silent)
		if self.Multi then
			local wanted = {}
			if type(value) == "table" then
				for k, v in pairs(value) do
					if type(k) == "number" then
						wanted[v] = true
					elseif v then
						wanted[k] = true
					end
				end
			elseif value ~= nil then
				wanted[value] = true
			end
			local arr, set = {}, {}
			for _, name in ipairs(self.Options) do
				if wanted[name] then
					table.insert(arr, name)
					set[name] = true
				end
			end
			self._set = set
			self.Value = arr
		else
			if value ~= nil and not table.find(self.Options, value) then
				value = nil
			end
			self.Value = value
		end
		updateText()
		paint()
		if self.Flag then
			Bee.Flags[self.Flag] = self.Value
		end
		if not silent then
			Commit(self, self.Value)
		end
	end

	function obj:Toggle(state)
		if state == nil then
			state = not isOpen
		end
		isOpen = state
		local lh = listHeight()
		Tween(frame, EASE.Smooth, { Size = UDim2.new(1, 0, 0, state and (38 + 8 + lh + 8) or 38) })
		Tween(list, EASE.Smooth, { Size = UDim2.new(1, -16, 0, state and lh or 0) })
		Tween(arrow, EASE.Smooth, { Rotation = state and 180 or 0 })
		Tween(stroke, EASE.Fast, { Color = state and theme.Accent or theme.Stroke })
	end

	function obj:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		build()
		if keepSelection then
			self:Set(self.Value, true)
		else
			self:Set(self.Multi and {} or nil, true)
		end
		if isOpen then
			self:Toggle(true)
		end
	end

	head.Activated:Connect(function()
		obj:Toggle()
	end)

	build()
	obj:Set(opts.Default, true)
	Register(obj, opts.Flag)
	return obj
end

-- ───────────────────────────── Textbox ─────────────────────────────

function Elements:AddTextbox(opts)
	opts = opts or {}
	local theme = self._window.Theme
	local frame, stroke = BaseElement(self, 38)

	NewLabel({
		Text = opts.Name or "Textbox",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.42, -12, 1, 0),
		TextColor3 = theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local box = Create("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0.58, -12, 0, 26),
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		Text = "",
		PlaceholderText = opts.Placeholder or "Type here...",
		PlaceholderColor3 = theme.SubText,
		TextColor3 = theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		ClearTextOnFocus = opts.ClearOnFocus == true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	CornerPx(box, 6)
	PaddingOf(box, 8, 0, 8, 0)
	local boxStroke = StrokeOf(box, theme.Stroke, 0.3, 1)

	local obj = NewObject(self, "Textbox", opts, frame)
	obj.Numeric = opts.Numeric == true

	function obj:Set(value, silent, enterPressed)
		if value == nil then
			value = ""
		end
		self.Value = value
		box.Text = tostring(value)
		if self.Flag then
			Bee.Flags[self.Flag] = value
		end
		if not silent then
			Commit(self, value, enterPressed == true)
		end
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		local t = box.Text
		if opts.Numeric then
			local cleaned = t:gsub("[^%d%.%-]", "")
			if cleaned ~= t then
				box.Text = cleaned
				return
			end
		end
		if opts.MaxLength and #t > opts.MaxLength then
			box.Text = t:sub(1, opts.MaxLength)
		end
	end)
	box.Focused:Connect(function()
		Tween(boxStroke, EASE.Fast, { Color = theme.Accent, Transparency = 0 })
		Tween(stroke, EASE.Fast, { Transparency = 0.1 })
	end)
	box.FocusLost:Connect(function(enterPressed)
		Tween(boxStroke, EASE.Fast, { Color = theme.Stroke, Transparency = 0.3 })
		Tween(stroke, EASE.Fast, { Transparency = 0.5 })
		if opts.Numeric then
			local n = tonumber(box.Text)
			if n == nil then
				box.Text = tostring(obj.Value or "")
				return
			end
			if opts.Min then
				n = math.max(n, opts.Min)
			end
			if opts.Max then
				n = math.min(n, opts.Max)
			end
			obj:Set(n, false, enterPressed)
		else
			obj:Set(box.Text, false, enterPressed)
		end
	end)

	obj:Set(opts.Default, true)
	Register(obj, opts.Flag)
	return obj
end

-- ───────────────────────────── Keybind ─────────────────────────────

function Elements:AddKeybind(opts)
	opts = opts or {}
	local win = self._window
	local theme = win.Theme
	local frame, stroke = BaseElement(self, 38)

	NewLabel({
		Text = opts.Name or "Keybind",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -110, 1, 0),
		TextColor3 = theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local keyBox = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(88, 24),
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		Parent = frame,
	})
	CornerPx(keyBox, 6)
	local keyStroke = StrokeOf(keyBox, theme.Stroke, 0.3, 1)
	local keyLabel = NewLabel({
		Size = UDim2.fromScale(1, 1),
		Text = "None",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = keyBox,
	})
	local btn = Overlay(frame)
	Hover(btn, frame, stroke, theme)

	local obj = NewObject(self, "Keybind", opts, frame)
	obj.Mode = opts.Mode or "Press" -- "Press" | "Toggle" | "Hold"
	obj.State = false
	obj.ChangedCallback = opts.ChangedCallback

	local listening = false

	function obj:Set(bind, silent)
		bind = ParseBind(bind)
		self.Value = bind
		keyLabel.Text = BindName(bind)
		if self.Flag then
			Bee.Flags[self.Flag] = bind
		end
		if not silent then
			SafeCall(self.ChangedCallback, bind)
			for _, fn in ipairs(self._listeners) do
				SafeCall(fn, bind)
			end
		end
	end

	function obj:IsDown()
		if self.Mode == "Hold" or self.Mode == "Toggle" then
			return self.State
		end
		if not self.Value then
			return false
		end
		if typeof(self.Value) == "EnumItem" and self.Value.EnumType == Enum.KeyCode then
			return UIS:IsKeyDown(self.Value)
		end
		return UIS:IsMouseButtonPressed(self.Value)
	end

	btn.Activated:Connect(function()
		if listening then
			return
		end
		listening = true
		Bee._listening = true
		keyLabel.Text = "..."
		Tween(keyStroke, EASE.Fast, { Color = theme.Accent, Transparency = 0 })
	end)

	win:_connect(UIS.InputBegan, function(input, processed)
		if listening then
			local bind
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
					bind = false
				else
					bind = input.KeyCode
				end
			elseif
				input.UserInputType == Enum.UserInputType.MouseButton2
				or input.UserInputType == Enum.UserInputType.MouseButton3
			then
				bind = input.UserInputType
			else
				return
			end
			listening = false
			task.delay(0.15, function()
				Bee._listening = false
			end)
			Tween(keyStroke, EASE.Fast, { Color = theme.Stroke, Transparency = 0.3 })
			obj:Set(bind or nil)
			return
		end

		if processed or not obj.Value then
			return
		end
		if input.KeyCode == obj.Value or input.UserInputType == obj.Value then
			if obj.Mode == "Toggle" then
				obj.State = not obj.State
				SafeCall(obj.Callback, obj.State)
			elseif obj.Mode == "Hold" then
				obj.State = true
				SafeCall(obj.Callback, true)
			else
				SafeCall(obj.Callback, obj.Value)
			end
		end
	end)

	win:_connect(UIS.InputEnded, function(input)
		if obj.Mode == "Hold" and obj.State and obj.Value then
			if input.KeyCode == obj.Value or input.UserInputType == obj.Value then
				obj.State = false
				SafeCall(obj.Callback, false)
			end
		end
	end)

	obj:Set(opts.Default, true)
	Register(obj, opts.Flag)
	return obj
end

-- ───────────────────────────── Color picker ─────────────────────────────

function Elements:AddColorPicker(opts)
	opts = opts or {}
	local win = self._window
	local theme = win.Theme
	local page = self._page
	local frame, stroke = BaseElement(self, 38)
	frame.ClipsDescendants = true

	local obj = NewObject(self, "ColorPicker", opts, frame)
	local h, s, v = 0, 0, 1
	local isOpen = false

	local head = Overlay(frame)
	head.Size = UDim2.new(1, 0, 0, 38)
	Hover(head, frame, stroke, theme)
	NewLabel({
		Text = opts.Name or "Color",
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -70, 1, 0),
		TextColor3 = theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = head,
	})
	local swatch = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, 19),
		Size = UDim2.fromOffset(40, 20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = head,
	})
	CornerPx(swatch, 6)
	StrokeOf(swatch, theme.Stroke, 0.2, 1)

	local area = Create("Frame", {
		Position = UDim2.fromOffset(12, 46),
		Size = UDim2.new(1, -24, 0, 110),
		BackgroundTransparency = 1,
		Parent = frame,
	})

	-- saturation / value square
	local sv = Create("Frame", {
		Size = UDim2.new(1, -30, 1, 0),
		BackgroundColor3 = Color3.fromHSV(0, 1, 1),
		BorderSizePixel = 0,
		Parent = area,
	})
	CornerPx(sv, 6)
	local white = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = sv,
	})
	CornerPx(white, 6)
	Create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Parent = white,
	})
	local black = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = sv,
	})
	CornerPx(black, 6)
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
		Parent = black,
	})
	local svCursor = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = sv,
	})
	CornerFull(svCursor)
	StrokeOf(svCursor, Color3.new(1, 1, 1), 0, 2)
	local svHit = Overlay(sv)

	-- hue bar
	local hue = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 18, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = area,
	})
	CornerPx(hue, 6)
	Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})
	local hueCursor = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 6, 0, 5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = hue,
	})
	CornerPx(hueCursor, 2)
	StrokeOf(hueCursor, Color3.new(0, 0, 0), 0.4, 1)
	local hueHit = Overlay(hue)

	local function paint()
		local color = Color3.fromHSV(h, s, v)
		obj.Value = color
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.new(0.5, 0, h, 0)
		if obj.Flag then
			Bee.Flags[obj.Flag] = color
		end
	end

	local function pickSV(pos)
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
	end
	local function pickHue(pos)
		h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1)
	end

	local dragMode = nil
	local function beginDrag(mode, input)
		dragMode = mode
		if page then
			page.ScrollingEnabled = false
		end
		if mode == "sv" then
			pickSV(input.Position)
		else
			pickHue(input.Position)
		end
		paint()
		Commit(obj, obj.Value)
	end
	svHit.InputBegan:Connect(function(input)
		if IsPress(input) then
			beginDrag("sv", input)
		end
	end)
	hueHit.InputBegan:Connect(function(input)
		if IsPress(input) then
			beginDrag("hue", input)
		end
	end)
	win:_connect(UIS.InputChanged, function(input)
		if dragMode and IsMove(input) then
			if dragMode == "sv" then
				pickSV(input.Position)
			else
				pickHue(input.Position)
			end
			paint()
			Commit(obj, obj.Value)
		end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if dragMode and IsPress(input) then
			dragMode = nil
			if page then
				page.ScrollingEnabled = true
			end
		end
	end)

	function obj:Set(color, silent)
		if typeof(color) ~= "Color3" then
			return
		end
		h, s, v = Color3.toHSV(color)
		paint()
		if not silent then
			Commit(self, self.Value)
		end
	end

	function obj:Toggle(state)
		if state == nil then
			state = not isOpen
		end
		isOpen = state
		Tween(frame, EASE.Smooth, { Size = UDim2.new(1, 0, 0, state and (38 + 8 + 110 + 10) or 38) })
		Tween(stroke, EASE.Fast, { Color = state and theme.Accent or theme.Stroke })
	end
	head.Activated:Connect(function()
		obj:Toggle()
	end)

	obj:Set(opts.Default or theme.Accent, true)
	Register(obj, opts.Flag)
	return obj
end

-- ───────────────────────────── Configs (executor file API, optional) ─────────────────────────────

local function ConfigPath(name)
	return Bee.ConfigFolder .. "/" .. name .. ".json"
end

function Bee:SaveConfig(name)
	if not (writefile and isfolder and makefolder) then
		return false, "File functions are not available in this environment"
	end
	local data = {}
	for flag, opt in pairs(self.Options) do
		local t, value = opt.Type, opt.Value
		if t == "ColorPicker" then
			data[flag] = { r = value.R, g = value.G, b = value.B }
		elseif t == "Keybind" then
			data[flag] = value and { enum = tostring(value.EnumType), name = value.Name } or false
		elseif t == "Toggle" or t == "Slider" or t == "Dropdown" or t == "Textbox" then
			data[flag] = value
		end
	end
	local ok, err = pcall(function()
		if not isfolder(self.ConfigFolder) then
			makefolder(self.ConfigFolder)
		end
		writefile(ConfigPath(name), HttpService:JSONEncode(data))
	end)
	return ok, err
end

function Bee:LoadConfig(name)
	if not (readfile and isfile) then
		return false, "File functions are not available in this environment"
	end
	local path = ConfigPath(name)
	if not isfile(path) then
		return false, "Config not found"
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false, "Invalid config file"
	end
	for flag, saved in pairs(data) do
		local opt = self.Options[flag]
		if opt then
			pcall(function()
				if opt.Type == "ColorPicker" then
					opt:Set(Color3.new(saved.r, saved.g, saved.b))
				elseif opt.Type == "Keybind" then
					if saved then
						opt:Set(Enum[saved.enum][saved.name])
					else
						opt:Set(nil)
					end
				else
					opt:Set(saved)
				end
			end)
		end
	end
	return true
end

if env then
	env.__BeeLib = Bee
end

return Bee
