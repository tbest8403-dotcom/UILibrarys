			KeyButton.Text = Key.Name
			UpdateFlag(self.Section.Window, Options.Flag, Key)

			if SkipNotify ~= true then
				self.Section.Window:_ActionNotify(Options.Name, Key.Name, Options.Notify)
			end
		end
