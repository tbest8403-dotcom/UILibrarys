		PaddingLeft = UDim.new(0, 9),
		PaddingRight = UDim.new(0, 9),
		Parent = Box
	})

	local Control = {
		Section = self,
		Instance = Row,
		Box = Box,
		SelectedPlayer = nil
	}

	function Control:Get()
		if self.SelectedPlayer and self.SelectedPlayer.Parent == Players then
			return self.SelectedPlayer
		end

		self.SelectedPlayer = nil
		return nil
	end

	function Control:Set(PlayerOrQuery, SkipCallback, SkipNotify)
		local Player = ResolvePlayer(PlayerOrQuery, IncludeLocalPlayer)
		self.SelectedPlayer = Player
		self.Section.Window.TargetPlayer = Player

		if Player then
			Box.Text = Player.DisplayName .. " (@" .. Player.Name .. ")"
			Box.TextColor3 = self.Section.Window.Theme.Text
			BoxStroke.Color = self.Section.Window.Theme.Success
			UpdateFlag(self.Section.Window, Options.Flag, Player)

			if SkipNotify ~= true then
				self.Section.Window:Notify({
					Title = "Target selected",
					Content = Player.DisplayName .. " (@" .. Player.Name .. ")",
					Type = "Success"
				})
			end
		else
			Box.TextColor3 = self.Section.Window.Theme.Error
			BoxStroke.Color = self.Section.Window.Theme.Error
			UpdateFlag(self.Section.Window, Options.Flag, nil)

