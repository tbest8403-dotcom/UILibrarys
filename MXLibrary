function WindowMethods:Close(SkipNotify)
	if self.Destroyed or not self.IsOpen then
		return
	end

	self.IsOpen = false

	if SkipNotify ~= true then
		self:Notify({ Title = "MX", Content = "Window minimized", Type = "Info", Duration = 2 })
	end

	Tween(self.Main, 0.18, {
		Size = UDim2.fromOffset(self.Size.X - 24, self.Size.Y - 18)
	}, Enum.EasingStyle.Quad)

	task.delay(0.19, function()
		if self.Destroyed or self.IsOpen then
			return
		end

		self.Main.Visible = false
		self.Logo.Visible = true
		self.Logo.Size = UDim2.fromOffset(0, 0)
		Tween(self.Logo, 0.22, {
			Size = UDim2.fromOffset(58, 38)
		})
	end)
end

function WindowMethods:Open(SkipNotify)
	if self.Destroyed or self.IsOpen then
		return
	end

	self.IsOpen = true
	Tween(self.Logo, 0.14, {
		Size = UDim2.fromOffset(0, 0)
	}, Enum.EasingStyle.Quad)

	task.delay(0.14, function()
		if self.Destroyed or not self.IsOpen then
			return
		end

		self.Logo.Visible = false
		self.Main.Visible = true
		self.Main.Size = UDim2.fromOffset(self.Size.X - 24, self.Size.Y - 18)
		Tween(self.Main, 0.22, {
			Size = UDim2.fromOffset(self.Size.X, self.Size.Y)
		})

		if SkipNotify ~= true then
			self:Notify({ Title = "MX", Content = "Window reopened", Type = "Success", Duration = 2 })
		end
	end)
end

function WindowMethods:Toggle()
	if self.IsOpen then
		self:Close()
	else
		self:Open()
	end
end

function WindowMethods:Destroy()
	if self.Destroyed then
		return
	end

	self.Destroyed = true

	for Index = #self.Connections, 1, -1 do
		local Connection = self.Connections[Index]
		if Connection then
			Connection:Disconnect()
		end
		self.Connections[Index] = nil
	end

	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end

	table.clear(self.Flags)
	table.clear(self.Tabs)
end

WindowMethods.Unload = WindowMethods.Destroy

