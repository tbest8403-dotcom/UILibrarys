	local TabList = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(7, 7),
		Size = UDim2.new(1, -14, 1, -42),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = TabPanel
	})
	Window.TabList = TabList

	local SidebarBrand = Create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -16, 0, 22),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "MX  /  CORE",
		TextColor3 = Theme.Muted,
		TextSize = 8,
		Parent = TabPanel
	})
	AddCorner(SidebarBrand, 6)
	AddStroke(SidebarBrand, Theme.Stroke, 1, 0.28)

	Create("UIListLayout", {
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = TabList
	})

	local Content = Create("Frame", {
		Position = UDim2.fromOffset(166, 58),
		Size = UDim2.new(1, -177, 1, -69),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = Main
	})
	Window.Content = Content

	local PageTitle = MakeTextLabel(
		Content,
		"",
		UDim2.new(1, 0, 0, 30),
		UDim2.fromOffset(1, 0),
		14,
		Theme.Text
	)
	PageTitle.Font = Enum.Font.GothamBold
	Window.PageTitle = PageTitle

	local PageAccent = Create("Frame", {
		Position = UDim2.fromOffset(1, 27),
		Size = UDim2.fromOffset(24, 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = Content
	})
	AddCorner(PageAccent, 2)

	local Logo = Create("Frame", {
		Name = "ReopenLogo",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(58, 38),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		Parent = ScreenGui
	})
	Window.Logo = Logo
	AddCorner(Logo, 11)
	AddStroke(Logo, Theme.Stroke, 1, 0.05)

	local LogoButton = Create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBlack,
		Text = "MX",
		TextColor3 = Theme.Text,
		TextSize = 14,
		Parent = Logo
	})

	Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(0.52, 0, 0, 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = Logo
	})

	local NotificationContainer = Create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(298, 500),
		BackgroundTransparency = 1,
		Parent = ScreenGui
	})
	Window.NotificationContainer = NotificationContainer

	Create("UIListLayout", {
		Padding = UDim.new(0, 7),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = NotificationContainer
	})

	local Dragging = false
	local DragInput
	local DragStart
	local StartPosition
	local LogoDragging = false
	local LogoDragInput
	local LogoDragStart
	local LogoStartPosition
	local LogoSuppressOpen = false

	Window:_Track(Header.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true
			DragStart = Input.Position
			StartPosition = Main.Position
		end
	end))

	Window:_Track(Header.InputChanged:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
			DragInput = Input
		end
	end))

	Window:_Track(LogoButton.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			LogoDragging = true
			LogoSuppressOpen = false
			LogoDragStart = Input.Position
			LogoStartPosition = Logo.Position
		end
	end))

	Window:_Track(LogoButton.InputChanged:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
			LogoDragInput = Input
		end
	end))

	Window:_Track(UserInputService.InputChanged:Connect(function(Input)
		if Dragging and Input == DragInput then
			local Delta = Input.Position - DragStart
			Main.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,
				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)
		end

		if LogoDragging and Input == LogoDragInput then
			local Delta = Input.Position - LogoDragStart
			local Camera = workspace.CurrentCamera

			if Delta.Magnitude >= 4 then
				LogoSuppressOpen = true
			end

			if Camera then
				local Viewport = Camera.ViewportSize
				local StartX = LogoStartPosition.X.Scale * Viewport.X + LogoStartPosition.X.Offset
				local StartY = LogoStartPosition.Y.Scale * Viewport.Y + LogoStartPosition.Y.Offset
				local HalfWidth = math.max(Logo.AbsoluteSize.X, 58) * Logo.AnchorPoint.X
				local LogoHeight = math.max(Logo.AbsoluteSize.Y, 38)
				local PositionX = math.clamp(StartX + Delta.X, HalfWidth, Viewport.X - HalfWidth)
				local PositionY = math.clamp(StartY + Delta.Y, 0, Viewport.Y - LogoHeight)
				Logo.Position = UDim2.fromOffset(PositionX, PositionY)
			else
				Logo.Position = UDim2.new(
					LogoStartPosition.X.Scale,
					LogoStartPosition.X.Offset + Delta.X,
					LogoStartPosition.Y.Scale,
					LogoStartPosition.Y.Offset + Delta.Y
				)
			end
		end
	end))

	Window:_Track(UserInputService.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = false
			DragInput = nil

			if LogoDragging then
				LogoDragging = false
				LogoDragInput = nil

				if LogoSuppressOpen then
					task.delay(0.2, function()
						if not LogoDragging then
							LogoSuppressOpen = false
						end
					end)
				end
			end
		end
	end))

	local function UpdateScale()
		local Camera = workspace.CurrentCamera
		if not Camera then
			return
		end

		local Viewport = Camera.ViewportSize
		Scale.Scale = math.clamp(math.min(Viewport.X / 640, Viewport.Y / 470), 0.64, 1)
	end

	Window:_Track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(UpdateScale))
	if workspace.CurrentCamera then
		Window:_Track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale))
	end

	Window:_Track(CloseButton.Activated:Connect(function()
		Window:Close(false)
	end))

	Window:_Track(LogoButton.Activated:Connect(function()
		if LogoSuppressOpen then
			return
		end

		Window:Open(false)
	end))

	CloseButton.MouseEnter:Connect(function()
		Tween(CloseButton, 0.14, {
			BackgroundColor3 = Theme.Error,
			TextColor3 = Theme.Text
		})
	end)

	CloseButton.MouseLeave:Connect(function()
		Tween(CloseButton, 0.14, {
			BackgroundColor3 = Theme.SurfaceLight,
			TextColor3 = Theme.Muted
		})
	end)

	UpdateScale()
	Window:Notify({
		Title = "MX loaded",
		Content = tostring(Options.WelcomeText or "Interface ready"),
		Type = "Success",
		Duration = 2.5
	})

	return Window
end

return MX
