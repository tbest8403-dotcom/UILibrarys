function WindowMethods:_Track(Connection)
	self.Connections[#self.Connections + 1] = Connection
	return Connection
end

function WindowMethods:_RunCallback(ActionName, Callback, ...)
	if type(Callback) ~= "function" then
		return true
	end

	local Arguments = table.pack(...)

	task.spawn(function()
		local Success, ErrorMessage = pcall(function()
			Callback(table.unpack(Arguments, 1, Arguments.n))
		end)

		if not Success and not self.Destroyed then
			self:Notify({
				Title = "Callback error",
				Content = tostring(ActionName) .. ": " .. tostring(ErrorMessage),
				Type = "Error",
				Duration = 5
			})
		end
	end)

	return true
end

function WindowMethods:_ActionNotify(Name, Value, Enabled)
	if not self.AutoNotify or Enabled == false then
		return
	end

	local Content = Value == nil and tostring(Name) or tostring(Name) .. " → " .. tostring(Value)

	self:Notify({
		Title = "MX",
		Content = Content,
		Type = "Info"
	})
end

function WindowMethods:Notify(Options)
	if self.Destroyed then
		return nil
	end

	if type(Options) == "string" then
		Options = { Content = Options }
	else
		Options = Options or {}
	end

	local TypeName = string.lower(tostring(Options.Type or "Info"))
	local AccentColor = self.Theme.Accent

	if TypeName == "success" then
		AccentColor = self.Theme.Success
	elseif TypeName == "warning" then
		AccentColor = self.Theme.Warning
	elseif TypeName == "error" then
		AccentColor = self.Theme.Error
	end

	local Holder = Create("CanvasGroup", {
		Size = UDim2.fromOffset(298, 0),
		BackgroundColor3 = self.Theme.Surface,
		BackgroundTransparency = 0.02,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		GroupTransparency = 1,
		Parent = self.NotificationContainer
	})
	AddCorner(Holder, 10)
	AddStroke(Holder, self.Theme.Stroke, 1, 0.15)

	Create("Frame", {
		Size = UDim2.fromOffset(4, 72),
		BackgroundColor3 = AccentColor,
		BorderSizePixel = 0,
		Parent = Holder
	})

	local Title = MakeTextLabel(
		Holder,
		tostring(Options.Title or "MX"),
		UDim2.new(1, -48, 0, 22),
		UDim2.fromOffset(15, 8),
		12,
		self.Theme.Text
	)
	Title.Font = Enum.Font.GothamBold

	local Content = MakeTextLabel(
		Holder,
		tostring(Options.Content or Options.Description or "Notification"),
		UDim2.new(1, -31, 0, 33),
		UDim2.fromOffset(15, 30),
		11,
		self.Theme.Muted
	)
	Content.TextWrapped = true
	Content.TextYAlignment = Enum.TextYAlignment.Top
	Content.TextTruncate = Enum.TextTruncate.None

	local Close = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -7, 0, 7),
		Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = "×",
		TextColor3 = self.Theme.Muted,
		TextSize = 16,
		Parent = Holder
	})

	local Closed = false
	local function Dismiss()
		if Closed then
			return
		end

		Closed = true
		Tween(Holder, 0.16, {
			GroupTransparency = 1,
			Size = UDim2.fromOffset(298, 0)
		}, Enum.EasingStyle.Quad)

		task.delay(0.18, function()
			if Holder then
				Holder:Destroy()
			end
		end)
	end

	Close.Activated:Connect(Dismiss)
	Tween(Holder, 0.22, {
		GroupTransparency = 0,
		Size = UDim2.fromOffset(298, 72)
	})
	task.delay(tonumber(Options.Duration) or 3, Dismiss)

	return {
		Close = Dismiss,
		Instance = Holder
	}
end

function WindowMethods:GetTarget()
	if self.TargetPlayer and self.TargetPlayer.Parent == Players then
		return self.TargetPlayer
	end

	self.TargetPlayer = nil
	return nil
end

function WindowMethods:SetTarget(PlayerOrQuery, Notify)
	local Player = ResolvePlayer(PlayerOrQuery, false)
	self.TargetPlayer = Player

	if Notify ~= false then
		if Player then
			self:Notify({
				Title = "Target selected",
				Content = Player.DisplayName .. " (@" .. Player.Name .. ")",
				Type = "Success"
			})
		else
			self:Notify({
				Title = "Target not found",
				Content = tostring(PlayerOrQuery or ""),
				Type = "Error"
			})
		end
	end

	return Player
end

function WindowMethods:SelectTab(Tab)
	if type(Tab) == "string" then
		for _, Candidate in ipairs(self.Tabs) do
			if Candidate.Name == Tab then
				Tab = Candidate
				break
			end
		end
	end

	if type(Tab) ~= "table" or Tab.Window ~= self then
		return
	end

	self.ActiveTab = Tab

	for _, Candidate in ipairs(self.Tabs) do
		local Selected = Candidate == Tab
		Candidate.Page.Visible = Selected
		Tween(Candidate.Button, 0.16, {
			BackgroundColor3 = Selected and self.Theme.SurfaceLight or self.Theme.Background,
			TextColor3 = Selected and self.Theme.Text or self.Theme.Muted
		})
		Tween(Candidate.Indicator, 0.16, {
			BackgroundTransparency = Selected and 0 or 1
		})
	end

	self.PageTitle.Text = Tab.Name
end

