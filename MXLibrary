		Section = self,
		Instance = Container,
		Values = Values
	}

	local function SetOpen(State)
		Open = State == true
		List.Visible = Open
		Choice.Text = tostring(Selected or Options.Placeholder or "Select") .. (Open and "  ▴" or "  ▾")
	end

	function Control:Get()
		return Selected
	end

	function Control:Set(NewValue, SkipCallback, SkipNotify)
		Selected = NewValue
		Choice.Text = tostring(Selected or Options.Placeholder or "Select") .. "  ▾"
		Choice.TextColor3 = Selected ~= nil and self.Section.Window.Theme.Text or self.Section.Window.Theme.Muted
		UpdateFlag(self.Section.Window, Options.Flag, Selected)
		SetOpen(false)

		if SkipNotify ~= true then
			self.Section.Window:_ActionNotify(Options.Name, Selected, Options.Notify)
		end

		if SkipCallback ~= true then
			self.Section.Window:_RunCallback(Options.Name, Options.Callback, Selected)
		end
	end

	function Control:Refresh(NewValues, KeepSelection)
		for _, Child in ipairs(List:GetChildren()) do
			if Child:IsA("TextButton") then
				Child:Destroy()
			end
		end

		self.Values = NewValues or {}
		Values = self.Values

		for Index, Item in ipairs(Values) do
			local ItemButton = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 31),
				BackgroundColor3 = self.Section.Window.Theme.SurfaceLight,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Font = Enum.Font.GothamMedium,
				Text = tostring(Item),
				TextColor3 = self.Section.Window.Theme.Muted,
				TextSize = 10,
				LayoutOrder = Index,
				Parent = List
			})
			AddCorner(ItemButton, 7)
			AddStroke(ItemButton, self.Section.Window.Theme.Stroke, 1, 0.24)

			ItemButton.Activated:Connect(function()
				Control:Set(Item, false, false)
			end)

			ItemButton.MouseEnter:Connect(function()
				Tween(ItemButton, 0.12, {
					BackgroundColor3 = self.Section.Window.Theme.SurfaceHover,
					TextColor3 = self.Section.Window.Theme.Text
				})
			end)

			ItemButton.MouseLeave:Connect(function()
				Tween(ItemButton, 0.12, {
					BackgroundColor3 = self.Section.Window.Theme.SurfaceLight,
					TextColor3 = self.Section.Window.Theme.Muted
				})
			end)
		end

		if not KeepSelection then
			Selected = nil
			Choice.Text = tostring(Options.Placeholder or "Select") .. "  ▾"
			UpdateFlag(self.Section.Window, Options.Flag, nil)
		end
	end

	Header.Activated:Connect(function()
		SetOpen(not Open)
	end)

	Control:Refresh(Values, true)
	if Selected ~= nil then
		Control:Set(Selected, true, true)
	end

	self.Controls[#self.Controls + 1] = Control
	return Control
end

