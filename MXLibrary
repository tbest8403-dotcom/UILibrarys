					Title = "Target not found",
					Content = tostring(PlayerOrQuery or ""),
					Type = "Error"
				})
			end
		end

		if SkipCallback ~= true then
			self.Section.Window:_RunCallback(Options.Name, UserCallback, Player, tostring(PlayerOrQuery or ""))
		end

		return Player
	end

	Box.Focused:Connect(function()
		Box.TextColor3 = self.Window.Theme.Text
		BoxStroke.Color = self.Window.Theme.Accent
		if Control.SelectedPlayer then
			Box.Text = Control.SelectedPlayer.Name
		end
	end)

	Box.FocusLost:Connect(function()
		BoxStroke.Color = self.Window.Theme.Stroke
		Control:Set(Box.Text, false, false)
	end)

	self.Controls[#self.Controls + 1] = Control
	return Control
end

