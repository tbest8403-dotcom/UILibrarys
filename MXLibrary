function SectionMethods:AddButton(Options)
	Options = NormalizeOptions(Options, "Button")
	local Row = self:_Row(48)

	local Button = Create("TextButton", {
		Position = UDim2.fromOffset(10, 7),
		Size = UDim2.new(1, -20, 0, 34),
		BackgroundColor3 = self.Window.Theme.SurfaceLight,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamMedium,
		Text = "  " .. Options.Name,
		TextColor3 = self.Window.Theme.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = Row
	})
	AddCorner(Button, 8)
	AddStroke(Button, self.Window.Theme.Stroke, 1, 0.22)

	local Action = MakeTextLabel(
		Button,
		tostring(Options.ActionText or "RUN"),
		UDim2.fromOffset(62, 34),
		UDim2.new(1, -70, 0, 0),
		10,
		self.Window.Theme.Accent
	)
	Action.Font = Enum.Font.GothamBold
	Action.TextXAlignment = Enum.TextXAlignment.Right

	local Control = {}

	function Control:Fire(SkipNotify)
		local Target = self.Targeted and self.Section:_Target() or nil

		if self.Targeted and not Target then
			self.Section.Window:Notify({
				Title = "Target required",
				Content = "Choose a player before using " .. Options.Name,
				Type = "Error"
			})
			return false
		end

		if SkipNotify ~= true then
			self.Section.Window:_ActionNotify(Options.Name, Target and Target.DisplayName or nil, Options.Notify)
		end

		if self.Targeted then
			self.Section.Window:_RunCallback(Options.Name, Options.Callback, Target)
		else
			self.Section.Window:_RunCallback(Options.Name, Options.Callback)
		end

		return true
	end

	Control.Section = self
	Control.Instance = Row
	Control.Targeted = Options.Targeted == true

	Button.Activated:Connect(function()
		Control:Fire(false)
	end)

	Button.MouseEnter:Connect(function()
		Tween(Button, 0.14, { BackgroundColor3 = self.Window.Theme.SurfaceHover })
	end)

	Button.MouseLeave:Connect(function()
		Tween(Button, 0.14, { BackgroundColor3 = self.Window.Theme.SurfaceLight })
	end)

	self.Controls[#self.Controls + 1] = Control
	return Control
end

