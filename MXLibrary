function SectionMethods:AddSlider(Options)
	Options = NormalizeOptions(Options, "Slider")
	local Minimum = tonumber(Options.Minimum or Options.Min) or 0
	local Maximum = tonumber(Options.Maximum or Options.Max) or 100
	local Increment = math.abs(tonumber(Options.Increment or Options.Step) or 1)
	local Decimals = GetDecimals(Increment)
	local Value = math.clamp(tonumber(Options.Default) or Minimum, Minimum, Maximum)
	local Dragging = false
	local Row = self:_Row(62)

	MakeTextLabel(
		Row,
		Options.Name,
		UDim2.new(1, -92, 0, 28),
		UDim2.fromOffset(13, 3),
		12,
		self.Window.Theme.Text
	)

	local ValueLabel = MakeTextLabel(
		Row,
		"",
		UDim2.fromOffset(80, 28),
		UDim2.new(1, -93, 0, 3),
		11,
		self.Window.Theme.Muted
	)
	ValueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local Track = Create("Frame", {
		Position = UDim2.fromOffset(13, 40),
		Size = UDim2.new(1, -26, 0, 6),
		BackgroundColor3 = self.Window.Theme.SurfaceLight,
		BorderSizePixel = 0,
		Active = true,
		Parent = Row
	})
	AddCorner(Track, 3)
	AddStroke(Track, self.Window.Theme.Stroke, 1, 0.12)

	local Fill = Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = self.Window.Theme.Accent,
		BorderSizePixel = 0,
		Parent = Track
	})
	AddCorner(Fill, 3)

	local Knob = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = self.Window.Theme.Text,
		BorderSizePixel = 0,
		Parent = Track
	})
	AddCorner(Knob, 8)

	local Control = {
		Section = self,
		Instance = Row
	}

	local function Draw()
		local Alpha = Maximum == Minimum and 0 or (Value - Minimum) / (Maximum - Minimum)
		Fill.Size = UDim2.fromScale(Alpha, 1)
		Knob.Position = UDim2.fromScale(Alpha, 0.5)
		ValueLabel.Text = FormatValue(Value, Decimals) .. tostring(Options.Suffix or "")
	end

	function Control:Get()
		return Value
	end

	function Control:Set(NewValue, SkipCallback, SkipNotify)
		NewValue = math.clamp(tonumber(NewValue) or Minimum, Minimum, Maximum)
		NewValue = math.round(NewValue / Increment) * Increment
		Value = math.clamp(NewValue, Minimum, Maximum)
		UpdateFlag(self.Section.Window, Options.Flag, Value)
		Draw()

		if SkipNotify ~= true then
			self.Section.Window:_ActionNotify(Options.Name, FormatValue(Value, Decimals) .. tostring(Options.Suffix or ""), Options.Notify)
		end

		if SkipCallback ~= true then
			self.Section.Window:_RunCallback(Options.Name, Options.Callback, Value)
		end
	end

	local function SetFromInput(Input, Notify)
		local Width = math.max(Track.AbsoluteSize.X, 1)
		local Alpha = math.clamp((Input.Position.X - Track.AbsolutePosition.X) / Width, 0, 1)
		Control:Set(Minimum + (Maximum - Minimum) * Alpha, false, not Notify)
	end

	Track.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true
			SetFromInput(Input, false)
		end
	end)

	self.Window:_Track(UserInputService.InputChanged:Connect(function(Input)
		if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
			SetFromInput(Input, false)
		end
	end))

	self.Window:_Track(UserInputService.InputEnded:Connect(function(Input)
		if Dragging and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
			Dragging = false
			self.Window:_ActionNotify(Options.Name, FormatValue(Value, Decimals) .. tostring(Options.Suffix or ""), Options.Notify)
		end
	end))

	UpdateFlag(self.Window, Options.Flag, Value)
	Draw()
	self.Controls[#self.Controls + 1] = Control
	return Control
end

