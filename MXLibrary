		Waiting = true
		KeyButton.Text = "PRESS A KEY"
		KeyButton.TextColor3 = self.Window.Theme.Accent
	end)

	self.Window:_Track(UserInputService.InputBegan:Connect(function(Input, Processed)
		if Waiting and Input.UserInputType == Enum.UserInputType.Keyboard then
			Waiting = false
			KeyButton.TextColor3 = self.Window.Theme.Muted

			if Input.KeyCode ~= Enum.KeyCode.Escape and Input.KeyCode ~= Enum.KeyCode.Unknown then
				Control:Set(Input.KeyCode, false)
			else
				KeyButton.Text = Key.Name
			end

			return
		end

		if not Processed and Input.UserInputType == Enum.UserInputType.Keyboard and Input.KeyCode == Key then
			self.Window:_ActionNotify(Options.Name, "USED", Options.Notify)
			self.Window:_RunCallback(Options.Name, Options.Callback, Key)
		end
	end))

	UpdateFlag(self.Window, Options.Flag, Key)
	self.Controls[#self.Controls + 1] = Control
	return Control
