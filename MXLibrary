function SectionMethods:AddToggle(Options)
	Options = NormalizeOptions(Options, "Toggle")
	local Row = self:_Row(47)
	local Value = Options.Default == true

	MakeTextLabel(
		Row,
		Options.Name,
		UDim2.new(1, -84, 1, 0),
		UDim2.fromOffset(13, 0),
		12,
		self.Window.Theme.Text
	)

	local Switch = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -13, 0.5, 0),
		Size = UDim2.fromOffset(46, 24),
		BackgroundColor3 = Value and self.Window.Theme.Accent or self.Window.Theme.SurfaceLight,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = Row
	})
	AddCorner(Switch, 12)
	local SwitchStroke = AddStroke(Switch, Value and self.Window.Theme.AccentDark or self.Window.Theme.Stroke, 1, 0.02)

	local Knob = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = Value and UDim2.fromScale(0.74, 0.5) or UDim2.fromScale(0.26, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = self.Window.Theme.Text,
		BorderSizePixel = 0,
		Parent = Switch
	})
	AddCorner(Knob, 9)

	local Control = {
		Section = self,
		Instance = Row,
		Targeted = Options.Targeted == true
	}

	function Control:Get()
		return Value
	end

	function Control:Set(NewValue, SkipCallback, SkipNotify)
		NewValue = NewValue == true
		local Target = self.Targeted and self.Section:_Target() or nil

		if NewValue and self.Targeted and not Target then
			self.Section.Window:Notify({
				Title = "Target required",
				Content = "Choose a player before enabling " .. Options.Name,
				Type = "Error"
			})
			return false
		end

		Value = NewValue
		UpdateFlag(self.Section.Window, Options.Flag, Value)
		Tween(Switch, 0.18, {
			BackgroundColor3 = Value and self.Section.Window.Theme.Accent or self.Section.Window.Theme.SurfaceLight
		})
		Tween(SwitchStroke, 0.18, {
			Color = Value and self.Section.Window.Theme.AccentDark or self.Section.Window.Theme.Stroke
		})
		Tween(Knob, 0.18, {
			Position = Value and UDim2.fromScale(0.74, 0.5) or UDim2.fromScale(0.26, 0.5)
		})

		if SkipNotify ~= true then
			self.Section.Window:_ActionNotify(Options.Name, Value and "ON" or "OFF", Options.Notify)
		end

		if SkipCallback ~= true then
			if self.Targeted then
				self.Section.Window:_RunCallback(Options.Name, Options.Callback, Value, Target)
			else
				self.Section.Window:_RunCallback(Options.Name, Options.Callback, Value)
			end
		end

		return true
	end

	Switch.Activated:Connect(function()
		Control:Set(not Value, false, false)
	end)

	UpdateFlag(self.Window, Options.Flag, Value)
	self.Controls[#self.Controls + 1] = Control
	return Control
end

