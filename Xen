function Window:_ApplySearch()
	local Query = string.lower(self.SearchBox.Text)
	Query = string.gsub(Query, "^%s*(.-)%s*$", "%1")

	local Matches = 0

	for _, PageObject in ipairs(self.PageOrder) do
		local Definition = PageObject.Definition
		local Searchable = string.lower(table.concat({
			tostring(Definition.Name or ""),
			tostring(Definition.Game or ""),
			tostring(Definition.Id or ""),
			tostring(Definition.Description or "")
		}, " "))

		local Visible = Query == ""
			or string.find(Searchable, Query, 1, true) ~= nil

		PageObject.Row.Visible = Visible

		if Visible then
			Matches += 1
		end
	end

	self.NoSearchResults.Visible = Query ~= "" and Matches == 0
end

function Window:_UpdateCount()
	local Count = #self.PageOrder
	self.ScriptCountLabel.Text = tostring(Count)
		.. (Count == 1 and " script registered" or " scripts registered")
end

function Window:RegisterScript(Definition)
	assert(type(Definition) == "table", "Xen:RegisterScript expects a table.")
	assert(type(Definition.Id) == "string" and Definition.Id ~= "", "Script Id is required.")
	assert(type(Definition.Name) == "string" and Definition.Name ~= "", "Script Name is required.")
	assert(
		type(Definition.Url or Definition.URL) == "string"
			or type(Definition.Loader) == "function",
		"A script Url or Loader function is required."
	)

	if self.Pages[Definition.Id] then
		error("Xen script Id is already registered: " .. Definition.Id)
	end

	Definition.Url = Definition.Url or Definition.URL

	local PageObject = setmetatable({
		Window = self,
		Definition = Definition,
		State = "Ready",
		Controller = nil,
		Connections = {},
		Controls = {}
	}, Page)

	self.Pages[Definition.Id] = PageObject
	self.PageOrder[#self.PageOrder + 1] = PageObject

	PageObject:_Build()
	self:_UpdateCount()
	self:_ApplySearch()
	self:_UpdateResponsiveLayout()

	if Definition.AutoSelect == true or #self.PageOrder == 1 then
		PageObject:_SetSelected(false)
	end

	return PageObject
end

function Window:RegisterScripts(Definitions)
	assert(type(Definitions) == "table", "Xen:RegisterScripts expects an array.")

	local Registered = {}

	for Index, Definition in ipairs(Definitions) do
		Registered[Index] = self:RegisterScript(Definition)
	end

	return Registered
end

function Window:GetScript(Id)
	return self.Pages[Id]
end

function Window:SelectScript(Id)
	local PageObject = self.Pages[Id]

	if PageObject then
		self:OpenPanel(PageObject)
	end

	return PageObject
end

function Window:Destroy()
	if self.Destroyed then
		return
	end

	self.Destroyed = true

	for _, PageObject in ipairs(self.PageOrder) do
		PageObject:Unload()
	end

	for _, Connection in ipairs(self.Connections) do
		SafeDisconnect(Connection)
	end

	table.clear(self.Connections)

	if self.Gui then
		self.Gui:Destroy()
		self.Gui = nil
	end
end

function Page:_Track(Connection)
	self.Connections[#self.Connections + 1] = Connection
	self.Window:_Track(Connection)
	return Connection
end

function Page:_SetSelected(Selected)
	self.Selected = Selected

	if self.Row then
		self.Row.BackgroundColor3 = Selected and COLORS.Raised or COLORS.Sidebar
	end
end

function Page:_SetState(State, Message)
	self.State = State
	self.StateMessage = Message

	local StateColor = COLORS.Muted

	if State == "Loaded" then
		StateColor = COLORS.Success
	elseif State == "Loading" then
		StateColor = COLORS.Warning
	elseif State == "Failed" then
		StateColor = COLORS.Danger
	end

	self.RowStatus.Text = State
	self.RowStatus.TextColor3 = StateColor
	self.StatusValue.Text = State
	self.StatusValue.TextColor3 = StateColor

	if State == "Loading" then
		self.LoadButton.Text = "Loading…"
		self.LoadButton.Active = false
	elseif State == "Loaded" then
		self.LoadButton.Text = "Loaded"
		self.LoadButton.Active = false
	elseif State == "Failed" then
		self.LoadButton.Text = "Try again"
		self.LoadButton.Active = true
	else
		self.LoadButton.Text = "Load script"
		self.LoadButton.Active = true
	end

	if Message and Message ~= "" then
		self.MessageLabel.Text = Message
		self.MessageLabel.Visible = true
	else
		self.MessageLabel.Visible = false
	end
end

