function Window:_AttachedMainPosition()
	local PanelWidth = self.Panel and self.Panel.Size.X.Offset or PANEL_WIDTH

	return OffsetPosition(
		self.ClosedPosition,
		-(PanelWidth + PANEL_GAP) / 2,
		0
	)
end

function Window:_AttachedPanelPosition(MainPosition)
	local MainWidth = self.Main and self.Main.Size.X.Offset or MAIN_WIDTH
	local PanelWidth = self.Panel and self.Panel.Size.X.Offset or PANEL_WIDTH

	return OffsetPosition(
		MainPosition,
		MainWidth / 2 + PANEL_GAP + PanelWidth / 2,
		0
	)
end

function Window:_DetachedPanelPosition()
	local MainWidth = self.Main and self.Main.Size.X.Offset or MAIN_WIDTH
	local PanelWidth = self.Panel and self.Panel.Size.X.Offset or PANEL_WIDTH

	return OffsetPosition(
		self.Main.Position,
		MainWidth / 2 + 26 + PanelWidth / 2,
		10
	)
end

function Window:OpenPanel(PageObject)
	if self.Destroyed then
		return
	end

	self.SelectedPage = PageObject
	self.PanelTitle.Text = PageObject.Definition.Name

	for _, RegisteredPage in ipairs(self.PageOrder) do
		RegisteredPage.Frame.Visible = RegisteredPage == PageObject
		RegisteredPage:_SetSelected(RegisteredPage == PageObject)
	end

	self.ContentTitle.Text = PageObject.Definition.Name
	self.ContentDescription.Text = PageObject.Definition.Description
		or ("Manage and load " .. PageObject.Definition.Name .. " from the attached panel.")

	if not self.PanelOpen then
		self.PanelOpen = true
		self.ClosedPosition = self.Main.Position
		self.Panel.Visible = true
		self.PanelScale.Scale = 0.97

		local MainTarget = self.Main.Position
		local PanelTarget

		if self.Attached then
			self.Panel.Size = UDim2.fromOffset(
				self.Panel.Size.X.Offset,
				self.Main.Size.Y.Offset
			)
			MainTarget = self:_AttachedMainPosition()
			PanelTarget = self:_AttachedPanelPosition(MainTarget)
		else
			PanelTarget = self:_DetachedPanelPosition()
		end

		self.Panel.Position = OffsetPosition(PanelTarget, 42, 0)

		if self.Attached then
			self:_Tween(self.Main, { Position = MainTarget })
		end

		self:_Tween(self.Panel, { Position = PanelTarget })
		self:_Tween(self.PanelScale, { Scale = 1 })
		self:_UpdateResponsiveLayout()
	else
		self.PanelScale.Scale = 0.985
		self:_Tween(self.PanelScale, { Scale = 1 }, 0.18)
	end
end

function Window:ClosePanel()
	if not self.PanelOpen or self.Destroyed then
		return
	end

	self.PanelOpen = false
	self.SelectedPage = nil

	local PanelTween = self:_Tween(self.Panel, {
		Position = OffsetPosition(self.Panel.Position, 42, 0)
	})

	self:_Tween(self.PanelScale, { Scale = 0.97 })
	self:_Tween(self.Main, { Position = self.ClosedPosition })

	PanelTween.Completed:Once(function()
		if not self.PanelOpen and self.Panel then
			self.Panel.Visible = false
		end
	end)
end

function Window:ToggleSplit()
	if not self.PanelOpen or self.Destroyed then
		return
	end

	self.Attached = not self.Attached

	if self.Attached then
		self.PanelModeLabel.Text = "Attached"
		self.SplitButton.Text = "▥"
		self.Panel.Size = UDim2.fromOffset(
			self.Panel.Size.X.Offset,
			self.Main.Size.Y.Offset
		)
		self:_Tween(self.Panel, {
			Position = self:_AttachedPanelPosition(self.Main.Position)
		})
	else
		self.PanelModeLabel.Text = "Detached"
		self.SplitButton.Text = "▣"
		self:_Tween(self.Panel, {
			Position = self:_DetachedPanelPosition()
		})
	end

	self:_UpdateResponsiveLayout()
end

