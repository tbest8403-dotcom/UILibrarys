function Page:AddToggle(Config)
	assert(type(Config) == "table", "Page:AddToggle expects a table.")

	local Value = Config.Default == true

	local Row = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = COLORS.Raised,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 14
	}, self.ControlsContainer)

	AddCorner(Row, 9)
	self.Window:_SetButtonHover(Row, COLORS.Raised, COLORS.Hover)
	self.Window:_AttachTooltip(Row, function()
		return (Value and "Disable " or "Enable ") .. (Config.Name or "this option")
	end)

	Create("TextLabel", {
		Position = UDim2.fromOffset(13, 0),
		Size = UDim2.new(1, -68, 1, 0),
		BackgroundTransparency = 1,
		Text = Config.Name or "Toggle",
		TextColor3 = COLORS.Text,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 15
	}, Row)

	local Track = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(38, 22),
		BackgroundColor3 = Value and self.Window.Accent or COLORS.Line,
		BorderSizePixel = 0,
		ZIndex = 15
	}, Row)

	AddCorner(Track, 11)

	local Knob = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = Value and UDim2.new(1, -11, 0.5, 0) or UDim2.new(0, 11, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 16
	}, Track)

	AddCorner(Knob, 8)

	local Control = {}

	local function Render(Animate)
		local Properties = {
			Position = Value and UDim2.new(1, -11, 0.5, 0) or UDim2.new(0, 11, 0.5, 0)
		}

		if Animate then
			self.Window:_Tween(Knob, Properties, 0.16)
			self.Window:_Tween(Track, {
				BackgroundColor3 = Value and self.Window.Accent or COLORS.Line
			}, 0.16)
		else
			Knob.Position = Properties.Position
			Track.BackgroundColor3 = Value and self.Window.Accent or COLORS.Line
		end
	end

	function Control:Set(NewValue, Silent)
		NewValue = NewValue == true

		if Value == NewValue then
			return
		end

		Value = NewValue
		Render(true)

		if not Silent and type(Config.Callback) == "function" then
			local Success, Error = pcall(Config.Callback, Value)

			if not Success then
				self.Page:SetMessage(Error)
			end
		end
	end

	function Control:Get()
		return Value
	end

	Control.Page = self

	self:_Track(Row.MouseButton1Click:Connect(function()
		Control:Set(not Value)
	end))

	Render(false)
	self.Controls[#self.Controls + 1] = Control
	self.Window:_UpdateResponsiveLayout()
	return Control
end

function Xen:CreateWindow(Config)
	Config = Config or {}

	local WindowObject = setmetatable({
		Config = Config,
		Title = Config.Title or "Xen",
		GuiName = Config.GuiName or "XenUILibrary",
		Accent = Config.Accent or Color3.fromRGB(104, 104, 99),
		Radius = Config.Radius or 14,
		MotionSeconds = Config.MotionSeconds or 0.32,
		Pages = {},
		PageOrder = {},
		Connections = {},
		PanelOpen = false,
		Attached = true,
		ProfileVisible = true,
		Minimized = false,
		Destroyed = false,
		ClosedPosition = UDim2.fromScale(0.5, 0.5),
		ClosedDragStart = UDim2.fromScale(0.5, 0.5),
		PanelDragStart = UDim2.new(0.5, 560, 0.5, 0)
	}, Window)

	WindowObject:_Build()
	return WindowObject
end

