function Page:Load()
	if self.State == "Loading" or self.State == "Loaded" then
		return self.Controller
	end

	self:_SetState("Loading")

	task.spawn(function()
		local Success, Result = pcall(function()
			if type(self.Definition.Loader) == "function" then
				return self.Definition.Loader()
			end

			if type(loadstring) ~= "function" then
				error("loadstring is not available in this environment.")
			end

			local Source = game:HttpGet(self.Definition.Url, true)
			local Chunk, CompileError = loadstring(Source)

			if not Chunk then
				error(CompileError or "The downloaded script did not compile.")
			end

			return Chunk()
		end)

		if not Success then
			self:_SetState("Failed", tostring(Result))
			return
		end

		self.Controller = Result
		self:_SetState("Loaded", "Loaded successfully.")

		if type(self.Definition.OnLoaded) == "function" then
			local Adapted, AdapterError = pcall(
				self.Definition.OnLoaded,
				self,
				Result
			)

			if not Adapted then
				self:_SetState("Failed", "Loaded, but its Xen adapter failed: " .. tostring(AdapterError))
			end
		end

		self.Window:_UpdateResponsiveLayout()
	end)

	return nil
end

function Page:Unload()
	for _, Connection in ipairs(self.Connections) do
		SafeDisconnect(Connection)
	end

	if type(self.Controller) == "table"
		and type(self.Controller.Destroy) == "function" then

		pcall(function()
			self.Controller:Destroy()
		end)
	end

	self.Controller = nil
end

