local function Create(ClassName, Properties, Parent)
	local Object = Instance.new(ClassName)

	for Property, Value in pairs(Properties or {}) do
		Object[Property] = Value
	end

	if Properties and type(Properties.TextSize) == "number" then
		Object:SetAttribute("XenBaseTextSize", Properties.TextSize)
	end

	Object.Parent = Parent
	return Object
end

local function AddCorner(Object, Radius)
	return Create("UICorner", {
		CornerRadius = UDim.new(0, Radius)
	}, Object)
end

local function AddStroke(Object, Color, Transparency)
	return Create("UIStroke", {
		Color = Color or COLORS.Line,
		Thickness = 1,
		Transparency = Transparency or 0
	}, Object)
end

local function AddPadding(Object, Left, Right, Top, Bottom)
	return Create("UIPadding", {
		PaddingLeft = UDim.new(0, Left or 0),
		PaddingRight = UDim.new(0, Right or 0),
		PaddingTop = UDim.new(0, Top or 0),
		PaddingBottom = UDim.new(0, Bottom or 0)
	}, Object)
end

local function OffsetPosition(Position, X, Y)
	return UDim2.new(
		Position.X.Scale,
		Position.X.Offset + X,
		Position.Y.Scale,
		Position.Y.Offset + Y
	)
end

local function ResolveParent(Config)
	if Config.Parent then
		return Config.Parent
	end

	if type(gethui) == "function" then
		local Success, HiddenUI = pcall(gethui)

		if Success and HiddenUI then
			return HiddenUI
		end
	end

	return LocalPlayer:WaitForChild("PlayerGui")
end

local function MakeDraggable(Handle, Frame, CanDrag, OnMove)
	local Dragging = false
	local DragStart = nil
	local StartPosition = nil
	local ActiveInput = nil
	local Connections = {}

	Connections[#Connections + 1] = Handle.InputBegan:Connect(function(Input)
		if not CanDrag() then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			DragStart = Input.Position
			StartPosition = Frame.Position
			ActiveInput = Input
		end
	end)

	Connections[#Connections + 1] = Handle.InputEnded:Connect(function(Input)
		if Input == ActiveInput then
			Dragging = false
			ActiveInput = nil
		end
	end)

	Connections[#Connections + 1] = UserInputService.InputChanged:Connect(function(Input)
		if not Dragging then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then

			local Delta = Input.Position - DragStart
			local Position = OffsetPosition(StartPosition, Delta.X, Delta.Y)

			Frame.Position = Position
			OnMove(Position, Delta)
		end
	end)

	return Connections
end

local function MakeResizable(Frame, Config)
	local Connections = {}
	local ActiveEdge = nil
	local ActiveInput = nil
	local DragStart = nil
	local StartSize = nil
	local StartPosition = nil

	local Handles = {
		{ "Left", "left", UDim2.new(0, 0, 0, 12), UDim2.new(0, 6, 1, -24), Vector2.new(0, 0) },
		{ "Right", "right", UDim2.new(1, 0, 0, 12), UDim2.new(0, 6, 1, -24), Vector2.new(1, 0) },
		{ "Top", "top", UDim2.new(0, 12, 0, 0), UDim2.new(1, -24, 0, 6), Vector2.new(0, 0) },
		{ "Bottom", "bottom", UDim2.new(0, 12, 1, 0), UDim2.new(1, -24, 0, 6), Vector2.new(0, 1) },
		{ "TopLeft", "top-left", UDim2.new(0, 0, 0, 0), UDim2.fromOffset(12, 12), Vector2.new(0, 0) },
		{ "TopRight", "top-right", UDim2.new(1, 0, 0, 0), UDim2.fromOffset(12, 12), Vector2.new(1, 0) },
		{ "BottomLeft", "bottom-left", UDim2.new(0, 0, 1, 0), UDim2.fromOffset(12, 12), Vector2.new(0, 1) },
		{ "BottomRight", "bottom-right", UDim2.new(1, 0, 1, 0), UDim2.fromOffset(12, 12), Vector2.new(1, 1) }
	}

	for _, Definition in ipairs(Handles) do
		local Handle = Create("Frame", {
			Name = "Resize" .. Definition[1],
			Position = Definition[3],
			Size = Definition[4],
			AnchorPoint = Definition[5],
			BackgroundColor3 = COLORS.Muted,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = true,
			ZIndex = Config.ZIndex or 30
		}, Frame)

		Connections[#Connections + 1] = Handle.InputBegan:Connect(function(Input)
			if not Config.CanResize(Definition[2]) then
				return
			end

			if Input.UserInputType == Enum.UserInputType.MouseButton1
				or Input.UserInputType == Enum.UserInputType.Touch then

				ActiveEdge = Definition[2]
				ActiveInput = Input
				DragStart = Input.Position
				StartSize = Frame.AbsoluteSize
				StartPosition = Frame.Position
			end
		end)
	end

	Connections[#Connections + 1] = UserInputService.InputChanged:Connect(function(Input)
		if not ActiveEdge then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.MouseMovement
			and Input.UserInputType ~= Enum.UserInputType.Touch then

			return
		end

		local Delta = Input.Position - DragStart
		local Width = StartSize.X
		local Height = StartSize.Y
		local ShiftX = 0
		local ShiftY = 0

		local Camera = workspace.CurrentCamera
		local Viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
		local MaxWidth = math.max(320, math.min(Config.MaxWidth, Viewport.X - 20))
		local MaxHeight = math.max(280, math.min(Config.MaxHeight, Viewport.Y - 20))
		local MinWidth = math.min(Config.MinWidth, MaxWidth)
		local MinHeight = math.min(Config.MinHeight, MaxHeight)

		if string.find(ActiveEdge, "left", 1, true) then
			Width = math.clamp(StartSize.X - Delta.X, MinWidth, MaxWidth)
			ShiftX = (StartSize.X - Width) / 2
		elseif string.find(ActiveEdge, "right", 1, true) then
			Width = math.clamp(StartSize.X + Delta.X, MinWidth, MaxWidth)
			ShiftX = (Width - StartSize.X) / 2
		end

		if string.find(ActiveEdge, "top", 1, true) then
			Height = math.clamp(StartSize.Y - Delta.Y, MinHeight, MaxHeight)
			ShiftY = (StartSize.Y - Height) / 2
		elseif string.find(ActiveEdge, "bottom", 1, true) then
			Height = math.clamp(StartSize.Y + Delta.Y, MinHeight, MaxHeight)
			ShiftY = (Height - StartSize.Y) / 2
		end

		Frame.Size = UDim2.fromOffset(math.floor(Width), math.floor(Height))
		Frame.Position = OffsetPosition(StartPosition, ShiftX, ShiftY)
		Config.OnResize(Frame, ActiveEdge)
	end)

	Connections[#Connections + 1] = UserInputService.InputEnded:Connect(function(Input)
		if not ActiveEdge then
			return
		end

		if Input == ActiveInput
			or Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			ActiveEdge = nil
			ActiveInput = nil
		end
	end)

	return Connections
end

local function SafeDisconnect(Connection)
	if Connection then
		pcall(function()
			Connection:Disconnect()
		end)
	end
end

local function ClearChildren(Container)
	for _, Child in ipairs(Container:GetChildren()) do
		if not Child:IsA("UIListLayout")
			and not Child:IsA("UIPadding") then

			Child:Destroy()
		end
	end
end

local function CreateXenMark(Parent, Position, ZIndex)
	local Mark = Create("Frame", {
		Name = "XenMark",
		Position = Position,
		Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1,
		ZIndex = ZIndex
	}, Parent)

	local Segments = {
		{ UDim2.fromOffset(5, 2), -34 },
		{ UDim2.fromOffset(5, 11), 34 },
		{ UDim2.fromOffset(16, 2), 34 },
		{ UDim2.fromOffset(16, 11), -34 }
	}

	for Index, Segment in ipairs(Segments) do
		local Bar = Create("Frame", {
			Name = "Segment" .. Index,
			Position = Segment[1],
			Size = UDim2.fromOffset(3, 12),
			BackgroundColor3 = Index <= 2 and COLORS.Text or COLORS.Muted,
			BorderSizePixel = 0,
			Rotation = Segment[2],
			ZIndex = ZIndex + 1
		}, Mark)

		AddCorner(Bar, 2)
	end

	return Mark
end

function Window:_Track(Connection)
	self.Connections[#self.Connections + 1] = Connection
	return Connection
end

function Window:_Tween(Object, Properties, Duration)
	local Tween = TweenService:Create(
		Object,
		TweenInfo.new(
			Duration or self.MotionSeconds,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		Properties
	)

	Tween:Play()
	return Tween
end

function Window:_SetButtonHover(Button, NormalColor, HoverColor)
	self:_Track(Button.MouseEnter:Connect(function()
		self:_Tween(Button, {
			BackgroundColor3 = HoverColor
		}, 0.12)
	end))

	self:_Track(Button.MouseLeave:Connect(function()
		self:_Tween(Button, {
			BackgroundColor3 = NormalColor
		}, 0.12)
	end))
end

function Window:_AttachTooltip(Button, Text)
	local function ResolveText()
		if type(Text) == "function" then
			local Success, Result = pcall(Text)
			return Success and tostring(Result or "") or ""
		end

		return tostring(Text or "")
	end

	self:_Track(Button.MouseEnter:Connect(function()
		if self.Destroyed or not self.Tooltip then
			return
		end

		local Label = ResolveText()

		if Label == "" then
			return
		end

		self.Tooltip.Text = Label
		self.Tooltip.Visible = true

		task.defer(function()
			if not self.Tooltip or not self.Tooltip.Visible or not Button.Parent then
				return
			end

			local Camera = workspace.CurrentCamera
			local Viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
			local Width = self.Tooltip.AbsoluteSize.X
			local Height = self.Tooltip.AbsoluteSize.Y
			local CenterX = Button.AbsolutePosition.X + Button.AbsoluteSize.X / 2
			local AboveY = Button.AbsolutePosition.Y - 7

			CenterX = math.clamp(CenterX, Width / 2 + 8, Viewport.X - Width / 2 - 8)

			if AboveY - Height < 8 then
				self.Tooltip.AnchorPoint = Vector2.new(0.5, 0)
				self.Tooltip.Position = UDim2.fromOffset(
					CenterX,
					Button.AbsolutePosition.Y + Button.AbsoluteSize.Y + 7
				)
			else
				self.Tooltip.AnchorPoint = Vector2.new(0.5, 1)
				self.Tooltip.Position = UDim2.fromOffset(CenterX, AboveY)
			end
		end)
	end))

	self:_Track(Button.MouseLeave:Connect(function()
		if self.Tooltip then
			self.Tooltip.Visible = false
		end
	end))

	self:_Track(Button.MouseButton1Click:Connect(function()
		if self.Tooltip then
			self.Tooltip.Visible = false
		end
	end))
end

function Window:_CreateIconButton(Parent, Text, Position, Label)
	local Button = Create("TextButton", {
		Name = Label:gsub("%s+", ""),
		Size = UDim2.fromOffset(30, 30),
		Position = Position,
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = Text,
		TextColor3 = COLORS.Muted,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		ZIndex = 12
	}, Parent)

	AddCorner(Button, 8)
	self:_SetButtonHover(Button, COLORS.Panel, COLORS.Hover)
	self:_AttachTooltip(Button, Label)
	return Button
end

function Window:_ScaleText(Container, Scale)
	for _, Object in ipairs(Container:GetDescendants()) do
		local BaseSize = Object:GetAttribute("XenBaseTextSize")

		if BaseSize and Object:IsA("GuiObject") then
			Object.TextSize = math.max(9, math.floor(BaseSize * Scale + 0.5))
		end
	end
end

function Window:_UpdateResponsiveLayout()
	if self.Destroyed or not self.Main then
		return
	end

	local MainSize = self.Main.AbsoluteSize
	local WidthScale = MainSize.X / MAIN_WIDTH
	local HeightScale = MainSize.Y / MAIN_HEIGHT
	local MainTextScale = math.clamp(math.min(WidthScale, HeightScale), 0.82, 1.2)
	local SidebarWidth = math.clamp(math.floor(218 * WidthScale), 180, 268)

	if self.Sidebar and self.Content then
		self.Sidebar.Size = UDim2.new(0, SidebarWidth, 1, 0)
		self.Content.Position = UDim2.fromOffset(SidebarWidth, 0)
		self.Content.Size = UDim2.new(1, -SidebarWidth, 1, 0)
	end

	self:_ScaleText(self.Main, MainTextScale)

	if self.Panel then
		local PanelSize = self.Panel.AbsoluteSize
		local PanelTextScale = math.clamp(
			math.min(PanelSize.X / PANEL_WIDTH, PanelSize.Y / MAIN_HEIGHT),
			0.84,
			1.2
		)

		self:_ScaleText(self.Panel, PanelTextScale)
	end
end

