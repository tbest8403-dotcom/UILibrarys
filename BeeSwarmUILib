function Tab:Destroy()
	if self._destroyed then return end
	self._destroyed = true
	for _, element in ipairs(table.clone(self._elements)) do element:Destroy() end
	disconnect(self)
	self.Button:Destroy(); self.Page:Destroy()
	local window = self._window
	local index = table.find(window.Tabs, self)
	if index then table.remove(window.Tabs, index) end
	if window.SelectedTab == self then
		window.SelectedTab = nil
		if window.Tabs[1] then window.Tabs[1]:Select()
		else window._pageTitle.Text = ""; window._pageDescription.Text = "" end
	end
end

local function colorValue(value)
	if typeof(value) == "Color3" then return value end
	if type(value) == "string" then
		local hex = value:gsub("^#", "")
		assert(#hex == 6 and hex:match("^%x+$"), "Color hex must contain six digits")
		return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
	end
	error("Color must be a Color3 or six-digit hex string", 3)
end

