function Window:Notify(options)
	if self._destroyed then return nil end
	if type(options) == "string" then options = { Content = options } end
	options = options or {}
	local duration = tonumber(options.Duration) or 4
	assert(duration >= 0 and duration < math.huge, "Notification Duration must be a finite nonnegative number")
	local toast = { _window = self, _connections = {}, _destroyed = false }
	local slot = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 100), LayoutOrder = self._toastOrder or 0 }, self._toastHost)
	self._toastOrder = (self._toastOrder or 0) + 1
	local card = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(35, 0), GroupTransparency = 1, BorderSizePixel = 0 }, slot)
	round(card, 11); self:_paint(card, "BackgroundColor3", "Surface"); self:_stroke(card)
	local color = defaultTheme[options.Type] and options.Type or "Accent"
	local accent = make("Frame", { Size = UDim2.new(0, 3, 1, -26), Position = UDim2.fromOffset(0, 13), BorderSizePixel = 0 }, card)
	round(accent, 3); self:_paint(accent, "BackgroundColor3", color)
	self:_text(card, options.Title or "A little buzz", 13, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -57, 0, 20) })
	self:_text(card, options.Content or "", 11, { Position = UDim2.fromOffset(16, 39), Size = UDim2.new(1, -36, 0, 39), TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top })
	local close = self:_button(card, "×", { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -34, 0, 10), TextSize = 18 }, toast)
	local progress = make("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), BorderSizePixel = 0 }, card)
	self:_paint(progress, "BackgroundColor3", color)
	local window = self
	function toast:Close(immediate)
		if self._destroyed then return end
		self._destroyed = true
		disconnect(self)
		local index = table.find(window._notifications, self)
		if index then table.remove(window._notifications, index) end
		if self._timer then
			window._tasks[self._timer] = nil
			pcall(task.cancel, self._timer)
			self._timer = nil
		end
		if self._progress then self._progress:Cancel(); self._progress:Destroy() end
		if immediate or window._destroyed then slot:Destroy(); return end
		window:_tween(card, { Position = UDim2.fromOffset(35, 0), GroupTransparency = 1 }, 0.18)
		window:_delay(window.ReducedMotion and 0 or 0.19, function() slot:Destroy() end)
	end
	connect(toast, close.Activated, function() toast:Close() end)
	table.insert(self._notifications, toast)
	if #self._notifications > 4 then self._notifications[1]:Close(true) end
	self:_tween(card, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.25)
	if duration > 0 then
		toast._progress = TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })
		toast._progress:Play()
		toast._timer = self:_delay(duration, function() toast._timer = nil; toast:Close() end)
	else progress.Visible = false end
	return toast
end

function Window:ExportConfig()
	assert(not self._destroyed, "Window has been destroyed")
	local values = {}
	for flag, element in pairs(self.Elements) do
		local value = element:Get()
		if element.Kind == "ColorPicker" then
			value = { value.R, value.G, value.B }
		elseif element.Kind == "Keybind" then value = value and value.Name or "None" end
		if element.Kind == "Toggle" or element.Kind == "Slider" or element.Kind == "Textbox" or element.Kind == "Dropdown" or element.Kind == "ColorPicker" or element.Kind == "Keybind" then
			values[flag] = { Kind = element.Kind, Value = value, Empty = value == nil or nil }
		end
	end
	return HttpService:JSONEncode({ Version = 1, Values = values })
end

function Window:LoadConfig(json, options)
	assert(not self._destroyed, "Window has been destroyed")
	options = options or {}
	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(data) ~= "table" or data.Version ~= 1 or type(data.Values) ~= "table" then return false, "Invalid BeeUI config or unsupported version" end
	local pending, errors = {}, {}
	for flag, record in pairs(data.Values) do
		local element = self.Elements[flag]
		if element then
			local valid, value = pcall(function()
				assert(type(record) == "table" and record.Kind == element.Kind, "Control type does not match")
				local candidate = record.Value
				if record.Empty == true then candidate = nil end
				if element.Kind == "Toggle" then assert(type(candidate) == "boolean", "Toggle requires boolean"); return candidate end
				if element.Kind == "ColorPicker" then
					assert(type(candidate) == "table" and #candidate == 3, "Invalid RGB array")
					for _, channel in ipairs(candidate) do assert(type(channel) == "number" and channel >= 0 and channel <= 1, "Invalid color channel") end
					candidate = Color3.new(candidate[1], candidate[2], candidate[3])
				end
				assert(element._validate, "Control has no saved value")
				return element._validate(candidate)
			end)
			if valid then table.insert(pending, { Element = element, Value = value })
			else table.insert(errors, tostring(flag) .. ": " .. tostring(value):gsub("^.-:%d+: ", "")) end
		end
	end
	if #errors > 0 then return false, table.concat(errors, "\n") end
	table.sort(pending, function(a, b) return a.Element.Flag < b.Element.Flag end)
	local changed = {}
	for _, entry in ipairs(pending) do
		local before = entry.Element:Get()
		entry.Element:Set(entry.Value, true)
		local after = entry.Element:Get()
		local differs = before ~= after
		if type(before) == "table" and type(after) == "table" then differs = table.concat(before, "\0") ~= table.concat(after, "\0") end
		if differs then table.insert(changed, entry.Element) end
	end
	if options.Silent ~= true then
		for _, element in ipairs(changed) do
			if element.Kind == "Keybind" then callback(element, element._changedCallback, element.Value)
			else callback(element, element.Callback, element:Get()) end
		end
	end
	return true
end

local function fileFunctions()
	return type(readfile) == "function" and readfile or nil, type(writefile) == "function" and writefile or nil
end

function Window:SaveConfig(path)
	assert(type(path) == "string" and #path > 0, "Config path is required")
	local _, write = fileFunctions()
	if not write then return false, "File APIs unavailable; use ExportConfig()" end
	local ok, result = pcall(function() write(path, self:ExportConfig()) end)
	if ok then return true end
	return false, tostring(result)
end

function Window:LoadConfigFile(path, options)
	assert(type(path) == "string" and #path > 0, "Config path is required")
	local read = fileFunctions()
	if not read then return false, "File APIs unavailable; use LoadConfig(json)" end
	local ok, result = pcall(read, path)
	if not ok then return false, tostring(result) end
	return self:LoadConfig(result, options)
end

function Window:SetReducedMotion(value)
	self.ReducedMotion = value == true
	if self.ReducedMotion then
		for _, bee in ipairs(self._bees) do
			if bee.Root.Parent then self:_animateBee(bee, 0, true) end
		end
	end
	return self
end

function Window:Destroy(external)
	if self._destroyed then return end
	self:_finishDrag(); self:_releaseKeys(); self:_cancelCapture()
	self._destroyed = true
	disconnect(self)
	for thread in pairs(self._tasks) do pcall(task.cancel, thread) end
	table.clear(self._tasks)
	for _, toast in ipairs(table.clone(self._notifications)) do toast:Close(true) end
	for _, tab in ipairs(table.clone(self.Tabs)) do tab:Destroy() end
	for _, tween in pairs(table.clone(self._tweens)) do tween:Cancel(); tween:Destroy() end
	table.clear(self._tweens); table.clear(self._themeBindings); table.clear(self._bees)
	table.clear(self.Flags); table.clear(self.Elements)
	if not external then self.Gui:Destroy() end
end

Library.Theme = table.freeze(table.clone(defaultTheme))
return Library
