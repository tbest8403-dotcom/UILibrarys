	list(self._nav, 6); pad(self._nav, 1, 1)
	local footerDot = make("Frame", { Position = UDim2.new(0, 18, 1, -27), Size = UDim2.fromOffset(6, 6), BorderSizePixel = 0 }, sidebar)
	round(footerDot, 6); self:_paint(footerDot, "BackgroundColor3", "Success")
