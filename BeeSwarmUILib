	self._pageTitle = self:_text(self._content, "", 23, { Position = UDim2.fromOffset(24, 19), Size = UDim2.new(1, -48, 0, 29), Font = Enum.Font.GothamBold })
	self._pageDescription = self:_text(self._content, "", 11, { Position = UDim2.fromOffset(25, 51), Size = UDim2.new(1, -48, 0, 18) })
	self:_paint(self._pageDescription, "TextColor3", "Muted")
	self._pages = make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 86), Size = UDim2.new(1, -40, 1, -102) }, self._content)
	local bubble = self:_button(gui, "", { Name = "Reopen", Visible = false, Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(24, 140) })
	self._bubble = bubble
	round(bubble, 30); self:_stroke(bubble, "AccentDark")
	self:_bee(bubble, UDim2.fromOffset(4, 4), 52)
	local bubbleMoved, bubbleStart, bubblePosition = false, nil, nil
	bindDrag(self, bubble, function(pos)
		bubbleMoved = false; bubbleStart = pos
		bubblePosition = Vector2.new(bubble.Position.X.Offset, bubble.Position.Y.Offset)
	end, function(pos)
		if (pos - bubbleStart).Magnitude > 5 then bubbleMoved = true end
		if bubbleMoved then
			local viewport = self._viewport
			local nextPos = bubblePosition + pos - bubbleStart
			bubble.Position = UDim2.fromOffset(math.clamp(nextPos.X, 0, math.max(0, viewport.X - 60)), math.clamp(nextPos.Y, 0, math.max(0, viewport.Y - 60)))
		end
	end)
	connect(self, bubble.Activated, function() if not bubbleMoved then self:SetVisible(true) end end)
	local dragStart, rootStart
	bindDrag(self, dragHandle, function(pos)
		dragStart = pos
		rootStart = self._center
	end, function(pos)
		local nextPos = rootStart + pos - dragStart
		self:_position(nextPos)
	end)
	self._toastHost = make("Frame", { Name = "Notifications", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20), Size = UDim2.new(0, 320, 1, -40), ZIndex = 20 }, gui)
	self._toastScale = make("UIScale", { Scale = 1 }, self._toastHost)
	make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right }, self._toastHost)
	local function resize()
		if self._destroyed then return end
		local camera = workspace.CurrentCamera
		self._viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		self._scale.Scale = math.min(self._userScale, math.max(0.1, (self._viewport.X - 24) / self._width), math.max(0.1, (self._viewport.Y - 24) / self._height))
		self._toastScale.Scale = math.min(1, math.max(0.1, (self._viewport.X - 24) / 320))
		self:_position(self._center or self._viewport / 2)
	end
	self._resize = resize
	local cameraConnection
	local function cameraChanged()
		if cameraConnection then cameraConnection:Disconnect() end
		local camera = workspace.CurrentCamera
		if camera then cameraConnection = connect(self, camera:GetPropertyChangedSignal("ViewportSize"), resize) end
		resize()
	end
	connect(self, workspace:GetPropertyChangedSignal("CurrentCamera"), cameraChanged)
	cameraChanged()
	connect(self, UserInputService.InputBegan, function(input, processed)
		if self._destroyed then return end
		local key = inputKey(input)
		if self._capture then
			if input.KeyCode == Enum.KeyCode.Escape then self:_cancelCapture(); return end
			if not key then return end
			local element = self._capture
			self._capture = nil
			if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then key = nil end
			element:Set(key)
			return
		end
		if processed or UserInputService:GetFocusedTextBox() then return end
		if key and key == self.ToggleKey then self:Toggle(); return end
		for _, element in ipairs(table.clone(self._keybinds)) do
			if not element.Disabled and not element._destroyed and element.Frame.Visible and key and key == element.Value and (self._visible or element.Global) then
				if element.Mode == "Hold" and not element._held then
					element._held = true; callback(element, element.Callback, true, key)
				elseif element.Mode == "Toggle" then
					element.Active = not element.Active; callback(element, element.Callback, element.Active, key)
				elseif element.Mode == "Press" then callback(element, element.Callback, key) end
			end
		end
	end)
	connect(self, UserInputService.InputEnded, function(input)
		for _, element in ipairs(table.clone(self._keybinds)) do
			if element._held and inputKey(input) == element.Value then
				element._held = false; callback(element, element.Callback, false, element.Value)
			end
		end
	end)
	connect(self, UserInputService.WindowFocusReleased, function() self:_finishDrag(); self:_releaseKeys(); self:_cancelCapture() end)
	connect(self, GuiService.MenuOpened, function() self:_finishDrag(); self:_releaseKeys(); self:_cancelCapture() end)
	local elapsed = 0
	connect(self, RunService.RenderStepped, function(dt)
		if self.ReducedMotion then return end
		elapsed += dt
		for _, bee in ipairs(self._bees) do
			if bee.Root.Parent and bee.Root:IsDescendantOf(gui) and ((self._visible and bee.Root:IsDescendantOf(root)) or (not self._visible and bee.Root:IsDescendantOf(bubble)) or (self._intro and bee.Root:IsDescendantOf(self._intro))) then
				self:_animateBee(bee, elapsed, false)
			end
		end
	end)
	if options.Intro ~= false then self:_showIntro(options.IntroText or "Gathering the good stuff…") end
	return self
end

function Window:_position(center)
	local viewport = self._viewport
	if not viewport then return end
	local half = Vector2.new(self._width, self._height) * self._scale.Scale / 2
	self.Root.Position = UDim2.fromOffset(math.clamp(center.X, half.X + 8, math.max(half.X + 8, viewport.X - half.X - 8)),
		math.clamp(center.Y, half.Y + 8, math.max(half.Y + 8, viewport.Y - half.Y - 8)))
	self._center = Vector2.new(self.Root.Position.X.Offset, self.Root.Position.Y.Offset)
end

function Window:SetTheme(theme)
	assert(type(theme) == "table", "Theme must be a table")
	for key, value in pairs(theme) do
		assert(defaultTheme[key] ~= nil and typeof(value) == "Color3", "Unknown theme key or invalid Color3: " .. tostring(key))
	end
	for key, value in pairs(theme) do self.Theme[key] = value end
	for object, bindings in pairs(self._themeBindings) do
		if object.Parent then
			local props = {}
			for property, key in pairs(bindings) do props[property] = type(key) == "function" and key(self.Theme) or self.Theme[key] end
			self:_tween(object, props)
		end
	end
	return self
end

function Window:SetScale(value)
	assert(type(value) == "number" and value > 0 and value < math.huge, "Scale must be a finite positive number")
	self._userScale = value
	self._resize()
	return self
end

function Window:SetTitle(title, subtitle)
	self._title.Text = tostring(title)
	if subtitle ~= nil then self._subtitle.Text = tostring(subtitle) end
	return self
end

function Window:SetVisible(value)
	if self._destroyed then return self end
	self._visible = value == true
	self:_finishDrag(); self:_releaseKeys(); self:_cancelCapture()
	self._visibilityToken = (self._visibilityToken or 0) + 1
	local token = self._visibilityToken
	self._bubble.Visible = not self._visible
	if self._visible then
		self.Root.Visible = true
		self:_tween(self._panel, { GroupTransparency = 0 }, 0.22)
		self:_tween(self._shadow, { BackgroundTransparency = 0.5 }, 0.22)
	else
		self:_tween(self._panel, { GroupTransparency = 1 }, 0.16)
		self:_tween(self._shadow, { BackgroundTransparency = 1 }, 0.16)
		self:_delay(self.ReducedMotion and 0 or 0.17, function() if self._visibilityToken == token then self.Root.Visible = false end end)
	end
	return self
end

function Window:Toggle() return self:SetVisible(not self._visible) end
function Window:IsVisible() return self._visible end
function Window:Get(flag) local item = self.Elements[flag]; return item and item:Get() end

function Window:_delay(seconds, fn)
	if self._destroyed then return nil end
	local thread
	thread = task.delay(seconds, function()
		self._tasks[thread] = nil
		if not self._destroyed then fn() end
	end)
	self._tasks[thread] = true
	return thread
end

