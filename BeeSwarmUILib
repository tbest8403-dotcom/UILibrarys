local function make(class, props, parent)
	local object = Instance.new(class)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function round(object, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, object)
end

local function pad(object, x, y)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, x), PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x), PaddingBottom = UDim.new(0, y or x),
	}, object)
end

local function list(object, spacing, horizontal)
	return make("UIListLayout", {
		Padding = UDim.new(0, spacing or 8), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
	}, object)
end

local function disconnect(owner)
	for _, connection in ipairs(owner._connections or {}) do
		connection:Disconnect()
	end
	table.clear(owner._connections or {})
end

local function connect(owner, signal, callback)
	local connection = signal:Connect(callback)
	table.insert(owner._connections, connection)
	return connection
end

local function callback(owner, fn, ...)
	if type(fn) ~= "function" or owner._destroyed then return end
	local ok, message = pcall(fn, ...)
	if not ok then warn("[BeeUI] Callback: " .. tostring(message)) end
end

local function pointer(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	return UserInputService:GetMouseLocation()
end

local function pressing(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function bindDrag(owner, handle, onStart, onMove, onEnd)
	local active
	local scrolling
	local function finish()
		if not active then return end
		active = nil
		if owner._window._drag and owner._window._drag.Owner == owner then owner._window._drag = nil end
		if owner._tab and not owner._tab._destroyed then owner._tab.Page.ScrollingEnabled = scrolling end
		if onEnd then onEnd() end
	end
	connect(owner, handle.InputBegan, function(input)
		if not pressing(input) or owner._destroyed or owner.Disabled then return end
		if owner._window._drag or owner._window._capture then return end
		active = input
		owner._window._drag = { Owner = owner, Finish = finish }
		if owner._tab then scrolling = owner._tab.Page.ScrollingEnabled; owner._tab.Page.ScrollingEnabled = false end
		local start = pointer(input)
		if onStart then onStart(start) end
		onMove(start)
	end)
	connect(owner, UserInputService.InputChanged, function(input)
		if active and (input == active or (active.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			if owner.Disabled then finish() return end
			onMove(pointer(input))
		end
	end)
	connect(owner, UserInputService.InputEnded, function(input)
		if active and (input == active or (active.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			finish()
		end
	end)
	return finish
end

function Window:_tween(object, props, duration)
	if self._destroyed or not object.Parent then return end
	local previous = self._tweens[object]
	if previous then previous:Cancel() end
	if self.ReducedMotion then
		for key, value in pairs(props) do object[key] = value end
		return
	end
	local tween = TweenService:Create(object, TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
	self._tweens[object] = tween
	tween.Completed:Once(function()
		if self._tweens[object] == tween then self._tweens[object] = nil end
		tween:Destroy()
	end)
	tween:Play()
	return tween
end

function Window:_paint(object, property, key)
	local bindings = self._themeBindings[object]
	if not bindings then bindings = {}; self._themeBindings[object] = bindings end
	bindings[property] = key
	object[property] = type(key) == "function" and key(self.Theme) or self.Theme[key]
end

function Window:_stroke(object, color)
	local stroke = make("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, object)
	self:_paint(stroke, "Color", color or "Border")
	return stroke
end

function Window:_text(parent, text, size, props)
	local settings = {
		BackgroundTransparency = 1, BorderSizePixel = 0, Text = tostring(text or ""),
		Font = Enum.Font.Gotham, TextSize = size or 13, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, 20),
	}
	for key, value in pairs(props or {}) do settings[key] = value end
	local label = make("TextLabel", settings, parent)
	self:_paint(label, "TextColor3", "Text")
	return label
end

function Window:_button(parent, text, props, owner)
	local settings = { Text = text or "", Font = Enum.Font.GothamMedium, TextSize = 13,
		AutoButtonColor = false, BorderSizePixel = 0, Size = UDim2.fromOffset(32, 32) }
	for key, value in pairs(props or {}) do settings[key] = value end
	local button = make("TextButton", settings, parent)
	round(button, 8)
	self:_paint(button, "BackgroundColor3", "Surface")
	self:_paint(button, "TextColor3", "Text")
	connect(owner or self, button.MouseEnter, function()
		self:_tween(button, { BackgroundColor3 = self.Theme.SurfaceHover })
	end)
	connect(owner or self, button.MouseLeave, function()
		self:_tween(button, { BackgroundColor3 = self.Theme.Surface })
	end)
	return button
end

function Window:_tabIcon(parent, name, color)
	name = name or "Honeycomb"
	local aliases = { ["⬡"] = "Honeycomb", ["≋"] = "Sliders", ["✦"] = "Settings" }
	name = aliases[name] or name
	local parts = {}
	if name ~= "Honeycomb" and name ~= "Sliders" and name ~= "Settings" then
		local icon = self:_text(parent, name, 19, { Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(24, 22), TextXAlignment = Enum.TextXAlignment.Center })
		self:_paint(icon, "TextColor3", color)
		return icon, { { Object = icon, Property = "TextColor3" } }
	end
	local icon = make("Frame", { Name = "Icon", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(24, 22) }, parent)
	local function bar(x, y, width, height, rotation)
		local part = make("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height), Rotation = rotation or 0 }, icon)
		round(part, 1)
		self:_paint(part, "BackgroundColor3", color)
		table.insert(parts, { Object = part, Property = "BackgroundColor3" })
	end
	if name == "Honeycomb" then
		for index = 0, 5 do
			local a = math.rad(index * 60)
			local b = math.rad((index + 1) * 60)
			local first = Vector2.new(math.cos(a), math.sin(a)) * 7.5
			local second = Vector2.new(math.cos(b), math.sin(b)) * 7.5
			local middle = (first + second) / 2
			local edge = second - first
			bar(12 + middle.X, 11 + middle.Y, edge.Magnitude + 0.5, 1.8, math.deg(math.atan2(edge.Y, edge.X)))
		end
	elseif name == "Sliders" then
		for index, x in ipairs({ 8, 16, 11 }) do
			local y = 5 + (index - 1) * 6
			bar(12, y, 17, 1.6)
			bar(x, y, 4, 5)
		end
	else
		for index = 0, 7 do
			local angle = math.rad(index * 45)
			bar(12 + math.cos(angle) * 7, 11 + math.sin(angle) * 7, 4, 3, index * 45)
		end
		local ring = make("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(12, 11), Size = UDim2.fromOffset(11, 11) }, icon)
		round(ring, 11)
		local stroke = make("UIStroke", { Thickness = 2 }, ring)
		self:_paint(stroke, "Color", color)
		table.insert(parts, { Object = stroke, Property = "Color" })
	end
	return icon, parts
end

function Window:_animateBee(bee, elapsed, still)
	local t = elapsed + bee.Phase
	local flutter = still and 0 or math.sin(t * 54)
	bee.Root.Rotation = 0
	bee.Motion.Position = UDim2.fromOffset(still and 0 or math.sin(t * 1.4) * 0.7, still and 0 or math.sin(t * 2.6) * math.min(4, bee.Size * 0.035))
	bee.Motion.Rotation = still and 0 or math.sin(t * 1.8) * 3 + math.sin(t * 0.85) * 1.2
	bee.Left.Rotation = -30 + flutter * 30
	bee.Right.Rotation = 30 - flutter * 28
	bee.LeftWing.Size = UDim2.fromScale(3.1 * (still and 1 or 0.78 + math.abs(flutter) * 0.22), 3.9)
	bee.RightWing.Size = UDim2.fromScale(3 * (still and 1 or 0.8 + math.abs(flutter) * 0.2), 3.8)
	bee.LeftWing.BackgroundTransparency = still and 0.12 or 0.12 + (1 - math.abs(flutter)) * 0.12
	bee.RightWing.BackgroundTransparency = still and 0.05 or 0.05 + (1 - math.abs(flutter)) * 0.1
	local blinkTime = (t + 1.3) % 4.8
	local blink = not still and blinkTime < 0.15 and 1 - math.sin(blinkTime / 0.15 * math.pi) * 0.93 or 1
	bee.Eye.Size = UDim2.fromScale(0.065, 0.075 * blink)
	for index, antenna in ipairs(bee.Antennae) do
		antenna.Root.Rotation = antenna.Angle + (still and 0 or math.sin(t * 5.3 + index * 1.7) * 6)
	end
	for index, mote in ipairs(bee.Pollen) do
		mote.Visible = not still
		if not still then
			local progress = (t * 0.6 + index * 0.5) % 1
			mote.Position = UDim2.fromScale(0.13 - progress * 0.2, 0.59 - progress * 0.14)
			mote.BackgroundTransparency = 0.35 + progress * 0.65
		end
	end
end

function Window:_bee(parent, position, size)
	local bee = make("Frame", { Name = "Bee", BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Position = position }, parent)
	local motion = make("Frame", { Name = "Hover", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, bee)
	local function part(name, x, y, width, height, color, angle, z)
		local frame = make("Frame", { Name = name, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(width, height), Rotation = angle or 0, ZIndex = z or 2 }, motion)
		round(frame, 100)
		if typeof(color) == "Color3" then frame.BackgroundColor3 = color else self:_paint(frame, "BackgroundColor3", color) end
		return frame
	end
	local function wing(name, x, y, width, height, color)
		local pivot = make("Frame", { Name = name .. "Pivot", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(0.1, 0.1), ZIndex = 1 }, motion)
		local feather = make("Frame", { Name = name, BorderSizePixel = 0, BackgroundColor3 = color, AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(width * 10, height * 10) }, pivot)
		round(feather, 100)
		return pivot, feather
	end
	local left, leftWing = wing("LeftWing", 0.4, 0.43, 0.31, 0.39, Color3.fromRGB(238, 239, 209))
	local right, rightWing = wing("RightWing", 0.6, 0.4, 0.3, 0.38, Color3.fromRGB(255, 247, 219))
	local antennae = {}
	for index, positionX in ipairs({ 0.69, 0.78 }) do
		local pivot = make("Frame", { Name = "Antenna", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(positionX, 0.35), Size = UDim2.fromScale(0.04, 0.04), ZIndex = 1 }, motion)
		local stem = make("Frame", { BackgroundColor3 = Color3.fromRGB(46, 34, 20), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(math.max(1, size * 0.022), size * 0.13) }, pivot)
		round(stem, 4)
		local tip = make("Frame", { BackgroundColor3 = Color3.fromRGB(46, 34, 20), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(size * 0.05, size * 0.05) }, stem)
		round(tip, 100)
		table.insert(antennae, { Root = pivot, Angle = index == 1 and -24 or 22 })
	end
	part("Stinger", 0.17, 0.58, 0.18, 0.12, "Background", 0, 1)
	local body = part("Body", 0.49, 0.54, 0.72, 0.47, "Accent", -9, 2)
	body.ClipsDescendants = true
	for index = 1, 2 do
		local height = index == 1 and 0.82 or 0.96
		local stripe = make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(46, 34, 20),
			Position = UDim2.fromScale(0.19 + (index - 1) * 0.25, (1 - height) / 2), Size = UDim2.fromScale(0.13, height), ZIndex = 3 }, body)
		round(stripe, 100)
	end
	local highlight = part("Highlight", 0.61, 0.405, 0.18, 0.035, Color3.fromRGB(255, 248, 224), -9, 4)
	highlight.BackgroundTransparency = 0.55
	local eye = part("Eye", 0.72, 0.49, 0.065, 0.075, Color3.fromRGB(46, 34, 20), 0, 4)
	local eyeLight = make("Frame", { Name = "EyeLight", BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		Position = UDim2.fromScale(0.55, 0.12), Size = UDim2.fromScale(0.3, 0.3), ZIndex = 5 }, eye)
	round(eyeLight, 100)
	part("Cheek", 0.75, 0.6, 0.1, 0.06, Color3.fromRGB(244, 144, 78), -9, 4)
	local pollen = {}
	for index = 1, 2 do
		table.insert(pollen, part("Pollen", 0.1, 0.58, 0.035, 0.035, "Accent", 0, 1))
	end
	local animation = { Root = bee, Motion = motion, Left = left, Right = right, LeftWing = leftWing, RightWing = rightWing,
		Eye = eye, Antennae = antennae, Pollen = pollen, Size = size, Phase = #self._bees * 1.8 }
	table.insert(self._bees, animation)
	self:_animateBee(animation, 0, self.ReducedMotion)
	return bee
end

function Window:_finishDrag()
	local drag = self._drag
	self._drag = nil
	if drag then drag.Finish() end
end

function Window:_releaseKeys()
	for _, element in ipairs(table.clone(self._keybinds)) do
		if element._held then
			element._held = false
			callback(element, element.Callback, false, element.Value)
		end
	end
end

function Window:_cancelCapture()
	if self._capture then
		local element = self._capture
		self._capture = nil
		element._render()
	end
end

local function normalizeKey(value)
	if value == nil or value == "None" then return nil end
	if typeof(value) == "EnumItem" then
		if value.EnumType == Enum.KeyCode and value ~= Enum.KeyCode.Unknown then return value end
		if value == Enum.UserInputType.MouseButton1 or value == Enum.UserInputType.MouseButton2 or value == Enum.UserInputType.MouseButton3 then return value end
	elseif type(value) == "string" then
		local name = value:match("([^%.]+)$")
		local ok, item = pcall(function() return Enum.KeyCode[name] end)
		if ok and item ~= Enum.KeyCode.Unknown then return item end
		ok, item = pcall(function() return Enum.UserInputType[name] end)
		if ok and (item == Enum.UserInputType.MouseButton1 or item == Enum.UserInputType.MouseButton2 or item == Enum.UserInputType.MouseButton3) then return item end
	end
	error("Expected a KeyCode, mouse button, key name, or 'None'", 3)
end

local function inputKey(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then return input.KeyCode end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then return input.UserInputType end
	return nil
end

function Library:CreateWindow(options)
	options = options or {}
	local player = Players.LocalPlayer
	assert(player, "BeeUI must run on a Roblox client")
	local self = setmetatable({
		Theme = table.clone(defaultTheme), Tabs = {}, Flags = {}, Elements = {},
		_connections = {}, _bees = {}, _keybinds = {}, _notifications = {}, _tasks = {},
		_themeBindings = setmetatable({}, { __mode = "k" }), _tweens = setmetatable({}, { __mode = "k" }),
		_visible = true, _destroyed = false, _userScale = options.Scale or 1,
		ReducedMotion = options.ReducedMotion == true, ToggleKey = normalizeKey(options.ToggleKey or Enum.KeyCode.RightShift),
	}, Window)
	self._window = self
	self:SetTheme(options.Theme or {})
	assert(type(self._userScale) == "number" and self._userScale > 0, "Scale must be positive")
	local parent = options.Parent
	if not parent and type(gethui) == "function" then
		local ok, result = pcall(gethui)
		if ok and typeof(result) == "Instance" then parent = result end
	end
	parent = parent or player:WaitForChild("PlayerGui")
	local id = "BeeUI_" .. tostring(options.Id or "Default")
	local previous = parent:FindFirstChild(id)
	if previous then
		local cleanup = previous:FindFirstChild("Cleanup")
		if cleanup and cleanup:IsA("BindableFunction") then pcall(function() cleanup:Invoke() end) end
		if previous.Parent then previous:Destroy() end
	end
	local gui = make("ScreenGui", {
		Name = id, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = options.DisplayOrder or 80,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.None,
	}, parent)
	self.Gui = gui
	local cleanup = make("BindableFunction", { Name = "Cleanup" }, gui)
	cleanup.OnInvoke = function() self:Destroy() end
	connect(self, gui.Destroying, function() self:Destroy(true) end)
	self._width = math.max(620, options.Width or 780)
	self._height = math.max(420, options.Height or 550)
	local root = make("Frame", { Name = "Window", BackgroundTransparency = 1,
		Size = UDim2.fromOffset(self._width, self._height), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, gui)
	self.Root = root
	self._scale = make("UIScale", { Scale = 1 }, root)
	local shadow = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5,
		Position = UDim2.fromOffset(-7, 8), Size = UDim2.new(1, 14, 1, 6), BorderSizePixel = 0, ZIndex = 0 }, root)
	round(shadow, 21)
	self._shadow = shadow
	local panel = make("CanvasGroup", { Name = "Panel", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, GroupTransparency = 0 }, root)
	self._panel = panel
	round(panel, 15)
	self:_paint(panel, "BackgroundColor3", "Background")
	self:_stroke(panel)
	local header = make("Frame", { Name = "Topbar", Size = UDim2.new(1, 0, 0, 76), BorderSizePixel = 0 }, panel)
	self:_paint(header, "BackgroundColor3", "Sidebar")
	local dragHandle = make("TextButton", { Name = "DragHandle", BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		Size = UDim2.new(1, -98, 1, 0) }, header)
	self:_bee(dragHandle, UDim2.fromOffset(15, 7), 64)
	self._title = self:_text(dragHandle, options.Title or "Bee UI", 22, { Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(87, 17), Size = UDim2.new(1, -110, 0, 27) })
	self._subtitle = self:_text(dragHandle, options.Subtitle or "A little honey. A lot of possibility.", 11, {
		Position = UDim2.fromOffset(88, 46), Size = UDim2.new(1, -110, 0, 17) })
	self:_paint(self._subtitle, "TextColor3", "Muted")
	local minimize = self:_button(header, "−", { Position = UDim2.new(1, -88, 0, 23), TextSize = 22 })
	local close = self:_button(header, "×", { Position = UDim2.new(1, -48, 0, 23), TextSize = 22 })
