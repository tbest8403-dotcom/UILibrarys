	for index, width in ipairs({ 22, 12, 17 }) do
		local drip = make("Frame", { Name = "HoneyDrip", Size = UDim2.fromOffset(width, 8 + index * 3), Position = UDim2.fromOffset(35 + index * 26, 74), BorderSizePixel = 0, ZIndex = 2 }, panel)
		round(drip, 10); self:_paint(drip, "BackgroundColor3", "Accent")
		local neck = make("Frame", { Name = "Neck", Size = UDim2.fromScale(1, 0.5), BorderSizePixel = 0, ZIndex = 2 }, drip)
		self:_paint(neck, "BackgroundColor3", "Accent")
	end
