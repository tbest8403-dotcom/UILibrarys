	local empty = window:_text(items, "No matches. Try another search.", 11, { Size = UDim2.new(1, -6, 0, 32), Visible = false, LayoutOrder = 1000000 })
	window:_paint(empty, "TextColor3", "Muted")
	local buttons = {}
	local function contains(value) return table.find(element.Options, value) ~= nil end
	local function normalize(value)
		if element.Multi then
			assert(type(value) == "table", "Multi dropdown requires an array")
			local set, output = {}, {}
			for _, item in ipairs(value) do assert(contains(item), "Unknown dropdown option: " .. tostring(item)); set[item] = true end
			for _, item in ipairs(element.Options) do if set[item] then table.insert(output, item) end end
			return output
		end
		assert(value == nil or contains(value), "Unknown dropdown option: " .. tostring(value))
		return value
	end
	element._validate = normalize
	local function isSelected(value)
		return element.Multi and table.find(element.Value or {}, value) ~= nil or (not element.Multi and element.Value == value)
	end
	local function render()
		selected.Text = element.Multi and (#(element.Value or {}) > 0 and table.concat(element.Value, ", ") or (options.Placeholder or "Choose options")) or (element.Value or options.Placeholder or "Choose an option")
		for _, entry in ipairs(buttons) do
			local active = isSelected(entry.Value)
			entry.Check.Visible = active
			window:_tween(entry.Label, { TextColor3 = active and window.Theme.Accent or window.Theme.Text })
			window:_tween(entry.Button, { BackgroundColor3 = active and window.Theme.SurfaceHover or window.Theme.Input })
		end
	end
	function element:Set(value, silent)
		value = normalize(value)
		if self._destroyed then return self end
		local changed = self.Multi and table.concat(self.Value or {}, "\0") ~= table.concat(value, "\0") or (not self.Multi and self.Value ~= value)
		self:_value(value, true)
		render()
		if changed and not silent then callback(self, self.Callback, self:Get()) end
		return self
	end
	function element:SetOpen(value)
		if self._destroyed then return self end
		self._open = value == true and not self.Disabled
		self._openToken = (self._openToken or 0) + 1
		local token = self._openToken
		if self._open then
			body.Visible = true
			window:_tween(self.Frame, { Size = UDim2.new(1, -7, 0, 310) }, 0.22)
		else
			search:ReleaseFocus()
			window:_tween(self.Frame, { Size = UDim2.new(1, -7, 0, 100) }, 0.2)
			window:_delay(window.ReducedMotion and 0 or 0.21, function() if not self._destroyed and self._openToken == token then body.Visible = false end end)
		end
		window:_tween(arrow, { Rotation = self._open and 180 or 0 })
		return self
	end
	local function filter()
		local query = string.lower(search.Text)
		local count = 0
		for _, entry in ipairs(buttons) do
			local matches = string.find(string.lower(entry.Value), query, 1, true) ~= nil
			entry.Button.Visible = matches
			if matches then count += 1 end
		end
		empty.Visible = count == 0
		items.CanvasPosition = Vector2.zero
	end
	function element:SetOptions(values, silent)
		assert(type(values) == "table", "Dropdown Options must be an array of strings")
		local normalized, seen = {}, {}
		for _, value in ipairs(values) do
			assert(type(value) == "string", "Dropdown options must be strings")
			if not seen[value] then seen[value] = true; table.insert(normalized, value) end
		end
		for _, connection in ipairs(self._optionConnections) do connection:Disconnect() end
		table.clear(self._optionConnections)
		for _, entry in ipairs(buttons) do entry.Button:Destroy() end
		table.clear(buttons)
		self.Options = normalized
		local optionOwner = { _connections = self._optionConnections }
		for index, value in ipairs(normalized) do
			local button = window:_button(items, "", { Size = UDim2.new(1, -5, 0, 31), LayoutOrder = index }, optionOwner)
			local label = window:_text(button, value, 12, { Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -42, 0, 20) })
			local ring = make("Frame", { Name = "Selection", BackgroundTransparency = 1, Position = UDim2.new(1, -25, 0.5, -6), Size = UDim2.fromOffset(12, 12) }, button)
			round(ring, 12); window:_stroke(ring, "Accent")
			local check = make("Frame", { Name = "Selected", BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6) }, ring)
			round(check, 6); window:_paint(check, "BackgroundColor3", "Accent")
			window:_paint(button, "BackgroundColor3", function(theme) return isSelected(value) and theme.SurfaceHover or theme.Input end)
			window:_paint(label, "TextColor3", function(theme) return isSelected(value) and theme.Accent or theme.Text end)
			table.insert(buttons, { Value = value, Button = button, Label = label, Check = check })
			connect(optionOwner, button.MouseLeave, function() window:_tween(button, { BackgroundColor3 = isSelected(value) and window.Theme.SurfaceHover or window.Theme.Input }) end)
			connect(optionOwner, button.Activated, function()
				if self.Disabled then return end
				if self.Multi then
					local nextValue = self:Get() or {}
					local found = table.find(nextValue, value)
					if found then table.remove(nextValue, found) else table.insert(nextValue, value) end
					self:Set(nextValue)
				else self:Set(value); self:SetOpen(false) end
			end)
		end
		local nextValue
		if self.Multi then
			nextValue = {}
			for _, value in ipairs(self.Value or {}) do if seen[value] then table.insert(nextValue, value) end end
		else nextValue = seen[self.Value] and self.Value or nil end
		self:Set(nextValue, silent)
		filter()
		return self
	end
	connect(element, search:GetPropertyChangedSignal("Text"), filter)
	connect(element, header.Activated, function() if not element.Disabled then element:SetOpen(not element._open) end end)
	connect(element, header.MouseLeave, function() window:_tween(header, { BackgroundColor3 = window.Theme.Input }) end)
	element._disable = function(disabled) search.TextEditable = not disabled; if disabled then element:SetOpen(false) end end
	local baseDestroy = element.Destroy
	function element:Destroy()
		for _, connection in ipairs(self._optionConnections) do connection:Disconnect() end
		table.clear(self._optionConnections)
		baseDestroy(self)
	end
	element:SetOptions(options.Options or {}, true)
	element:Set(options.Default or (element.Multi and {} or nil), true)
	return finishElement(element, options)
end

function Tab:AddTextbox(options)
	options = options or {}
	local element = self:_element(options, "Textbox", 104)
	local window = self._window
	element._title.Size = UDim2.new(1, -30, 0, 19)
	element._title.Position = UDim2.fromOffset(15, 12)
	element._description.Size = UDim2.new(1, -30, 0, 16)
	element._description.Position = UDim2.fromOffset(15, 34)
	local box = make("TextBox", { Text = "", PlaceholderText = options.Placeholder or "Type something sweet…", ClearTextOnFocus = false,
		Position = UDim2.fromOffset(12, 58), Size = UDim2.new(1, -24, 0, 33), Font = Enum.Font.Gotham,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0, TextTruncate = Enum.TextTruncate.AtEnd }, element.Frame)
	pad(box, 10, 0); round(box, 7)
	window:_paint(box, "BackgroundColor3", "Input"); window:_paint(box, "TextColor3", "Text"); window:_paint(box, "PlaceholderColor3", "Muted")
	local stroke = window:_stroke(box)
	element.Input = box
	local changing = false
	local function validate(value)
		assert(type(value) == "string", "Textbox value must be a string")
		if options.MaxLength then
			local length = utf8.len(value)
			if length and length > options.MaxLength then
				value = value:sub(1, (utf8.offset(value, options.MaxLength + 1) or (#value + 1)) - 1)
			end
		end
		if options.Numeric and value ~= "" then
			local number = tonumber(value)
			assert(number and number == number and math.abs(number) < math.huge, "Enter a finite number")
		end
		if options.Validate then
			local ok, message = options.Validate(value)
			assert(ok, message or "Invalid text")
		end
		return value
	end
	if options.MaxLength then assert(type(options.MaxLength) == "number" and options.MaxLength >= 0 and options.MaxLength % 1 == 0, "MaxLength must be a nonnegative integer") end
	element._validate = validate
	function element:Set(value, silent)
		value = validate(value)
		if self._destroyed then return self end
		local changed = self.Value ~= value
		self:_value(value, true)
		changing = true; box.Text = value; changing = false
		if changed and not silent then callback(self, self.Callback, value) end
		return self
	end
	local function commit()
		local ok, value = pcall(validate, box.Text)
		if ok then element:Set(value) else
			changing = true; box.Text = element.Value or ""; changing = false
			window:Notify({ Title = "Check your input", Content = tostring(value):gsub("^.-:%d+: ", ""), Type = "Warning", Duration = 3 })
		end
	end
	connect(element, box.Focused, function() window:_tween(stroke, { Color = window.Theme.AccentDark }) end)
	connect(element, box.FocusLost, function(enterPressed)
		window:_tween(stroke, { Color = window.Theme.Border })
		if not element.Disabled and (not options.EnterOnly or enterPressed) then commit()
		elseif options.EnterOnly then changing = true; box.Text = element.Value or ""; changing = false end
	end)
	if options.Live then
		connect(element, box:GetPropertyChangedSignal("Text"), function()
			if changing or element.Disabled then return end
			local ok, value = pcall(validate, box.Text)
			if ok then element:Set(value) end
		end)
	end
	element._disable = function(disabled) box.TextEditable = not disabled; if disabled then box:ReleaseFocus() end end
	element:Set(tostring(options.Default or ""), true)
	return finishElement(element, options)
end

function Tab:AddKeybind(options)
	options = options or {}
	local mode = options.Mode or "Press"
	assert(mode == "Press" or mode == "Hold" or mode == "Toggle", "Keybind Mode must be Press, Hold, or Toggle")
	local element = self:_element(options, "Keybind")
	local window = self._window
	element.Mode, element.Global, element.Active = mode, options.Global == true, false
	element._changedCallback = options.Changed
	element._title.Size = UDim2.new(1, -150, 0, 19)
	element._description.Size = UDim2.new(1, -150, 0, 16)
	local button = window:_button(element.Frame, "", { Position = UDim2.new(1, -130, 0.5, -16), Size = UDim2.fromOffset(114, 32), TextSize = 11 }, element)
	window:_paint(button, "BackgroundColor3", "Input"); window:_paint(button, "TextColor3", "Accent")
	window:_stroke(button)
	element._render = function() button.Text = window._capture == element and "Press a key…" or (element.Value and element.Value.Name or "None") end
	element._validate = normalizeKey
	function element:Set(value, silent)
		value = normalizeKey(value)
		if self._destroyed then return self end
		if self._held then self._held = false; callback(self, self.Callback, false, self.Value) end
		local changed = self.Value ~= value
		self.Active = false
		self:_value(value, true)
		self._render()
		if changed and not silent then callback(self, options.Changed, value) end
		return self
	end
	function element:SetMode(value)
		assert(value == "Press" or value == "Hold" or value == "Toggle", "Invalid keybind mode")
		if self._held then self._held = false; callback(self, self.Callback, false, self.Value) end
		self.Mode = value; self.Active = false
		return self
	end
	connect(element, button.Activated, function()
		if element.Disabled then return end
		window:_cancelCapture(); window:_releaseKeys()
		window._capture = element
		element._render()
	end)
	connect(element, button.MouseLeave, function() window:_tween(button, { BackgroundColor3 = window.Theme.Input }) end)
	table.insert(window._keybinds, element)
	element:Set(options.Default, true)
	element:SetDisabled(element.Disabled)
	return element
end

