function Window:CreateTab(options)
	assert(not self._destroyed, "Window has been destroyed")
	if type(options) == "string" then options = { Name = options } end
	options = options or {}
	local tab = setmetatable({ _window = self, _connections = {}, _elements = {}, _order = 0,
		Name = options.Name or "Tab", Description = options.Description or "Make yourself at home.", _destroyed = false }, Tab)
	local button = self:_button(self._nav, "", { Name = tab.Name, Size = UDim2.new(1, -2, 0, 42), LayoutOrder = #self.Tabs + 1 }, tab)
	tab.Button = button
	self:_paint(button, "BackgroundColor3", function(theme) return self.SelectedTab == tab and theme.SurfaceHover or theme.Sidebar end)
	tab._marker = make("Frame", { Size = UDim2.fromOffset(3, 18), Position = UDim2.new(0, 0, 0.5, -9), BorderSizePixel = 0, Visible = false }, button)
	round(tab._marker, 3); self:_paint(tab._marker, "BackgroundColor3", "Accent")
	tab._icon, tab._iconParts = self:_tabIcon(button, options.Icon, function(theme) return self.SelectedTab == tab and theme.Accent or theme.Muted end)
	tab._label = self:_text(button, tab.Name, 12, { Position = UDim2.fromOffset(44, 12), Size = UDim2.new(1, -52, 0, 18), Font = Enum.Font.GothamMedium })
	self:_paint(tab._label, "TextColor3", function(theme) return self.SelectedTab == tab and theme.Text or theme.Muted end)
	local page = make("ScrollingFrame", { Name = tab.Name, BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), Visible = false, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.Y }, self._pages)
	tab.Page = page
	self:_paint(page, "ScrollBarImageColor3", "AccentDark")
	pad(page, 4, 4); list(page, 9)
	connect(tab, button.Activated, function() tab:Select() end)
	connect(tab, button.MouseLeave, function() self:_tween(button, { BackgroundColor3 = self.SelectedTab == tab and self.Theme.SurfaceHover or self.Theme.Sidebar }) end)
	table.insert(self.Tabs, tab)
	if not self.SelectedTab then tab:Select() end
	return tab
end

function Tab:Select()
	local window = self._window
	if self._destroyed or window._destroyed then return self end
	window:_finishDrag(); window:_releaseKeys(); window:_cancelCapture()
	window.SelectedTab = self
	for _, tab in ipairs(window.Tabs) do
		local selected = tab == self
		tab.Page.Visible = selected
		tab._marker.Visible = selected
		window:_tween(tab.Button, { BackgroundColor3 = selected and window.Theme.SurfaceHover or window.Theme.Sidebar })
		for _, part in ipairs(tab._iconParts) do
			window:_tween(part.Object, { [part.Property] = selected and window.Theme.Accent or window.Theme.Muted })
		end
		window:_tween(tab._label, { TextColor3 = selected and window.Theme.Text or window.Theme.Muted })
	end
	window._pageTitle.Text = self.Name
	window._pageDescription.Text = self.Description
	self.Page.Position = UDim2.fromOffset(0, window.ReducedMotion and 0 or 8)
	window:_tween(self.Page, { Position = UDim2.fromOffset(0, 0) }, 0.25)
	return self
end

function Tab:_element(options, kind, height)
	assert(not self._destroyed and not self._window._destroyed, "Tab has been destroyed")
	options = options or {}
	local window = self._window
	local flag = options.Flag
	assert(flag == nil or (type(flag) == "string" and #flag > 0), "Flag must be a nonempty string")
	assert(not flag or not window.Elements[flag], "Duplicate flag: " .. tostring(flag))
	self._order += 1
	local element = setmetatable({ _window = window, _tab = self, _connections = {}, _destroyed = false,
		Kind = kind, Flag = flag, Name = options.Name or kind, Description = options.Description,
		Callback = options.Callback, Disabled = options.Disabled == true, _height = height or 64,
	}, Element)
	local row = make("Frame", { Name = kind, BorderSizePixel = 0, Size = UDim2.new(1, -7, 0, height or 64), LayoutOrder = self._order }, self.Page)
	element.Frame = row
	round(row, 10); window:_paint(row, "BackgroundColor3", "Surface"); window:_stroke(row)
	element._title = window:_text(row, element.Name, 13, { Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(15, options.Description and 13 or 22), Size = UDim2.new(1, -110, 0, 19) })
	element._description = window:_text(row, options.Description or "", 11, { Position = UDim2.fromOffset(15, 35), Size = UDim2.new(1, -110, 0, 16), Visible = options.Description ~= nil })
	window:_paint(element._description, "TextColor3", "Muted")
	table.insert(self._elements, element)
	if flag then window.Elements[flag] = element end
	return element
end

function Element:_value(value, silent)
	self.Value = type(value) == "table" and table.clone(value) or value
	if self.Flag then self._window.Flags[self.Flag] = self:Get() end
	if not silent then callback(self, self.Callback, self:Get()) end
end

function Element:Get() return type(self.Value) == "table" and table.clone(self.Value) or self.Value end
function Element:SetCallback(fn) assert(type(fn) == "function" or fn == nil, "Callback must be a function"); self.Callback = fn; return self end
function Element:SetName(name) self.Name = tostring(name); self._title.Text = self.Name; return self end
function Element:SetDescription(text)
	self.Description = text and tostring(text) or nil
	self._description.Text = self.Description or ""
	self._description.Visible = self.Description ~= nil
	self._title.Position = UDim2.fromOffset(15, self.Description and 13 or 22)
	return self
end
function Element:SetVisible(value)
	self.Frame.Visible = value == true
	if not value then
		if self._window._drag and self._window._drag.Owner == self then self._window:_finishDrag() end
		if self._window._capture == self then self._window:_cancelCapture() end
		if self._held then self._held = false; callback(self, self.Callback, false, self.Value) end
	end
	return self
end
function Element:SetDisabled(value)
	self.Disabled = value == true
	self._title.TextTransparency = self.Disabled and 0.55 or 0
	self._description.TextTransparency = self.Disabled and 0.55 or 0
	if self.Disabled then
		if self._window._capture == self then self._window:_cancelCapture() end
		if self._window._drag and self._window._drag.Owner == self then self._window:_finishDrag() end
		if self._held then self._held = false; callback(self, self.Callback, false, self.Value) end
	end
	if self._disable then self._disable(self.Disabled) end
	return self
end

function Element:Destroy()
	if self._destroyed then return end
	self:SetDisabled(true)
	self._destroyed = true
	disconnect(self)
	local window = self._window
	if self.Flag then window.Elements[self.Flag] = nil; window.Flags[self.Flag] = nil end
	local keyIndex = table.find(window._keybinds, self)
	if keyIndex then table.remove(window._keybinds, keyIndex) end
	local index = table.find(self._tab._elements, self)
	if index then table.remove(self._tab._elements, index) end
	self.Frame:Destroy()
end

local function finishElement(element, options)
	element:SetDisabled(element.Disabled)
	if options.FireOnInit then callback(element, element.Callback, element:Get()) end
	return element
end

function Tab:AddToggle(options)
	options = options or {}
	local element = self:_element(options, "Toggle")
	local window = self._window
	local hit = make("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), AutoButtonColor = false }, element.Frame)
	local track = make("Frame", { Size = UDim2.fromOffset(42, 24), Position = UDim2.new(1, -58, 0.5, -12), BorderSizePixel = 0 }, hit)
	round(track, 20)
	local knob = make("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(4, 4), BorderSizePixel = 0 }, track)
	round(knob, 20)
	window:_paint(track, "BackgroundColor3", function(theme) return element.Value and theme.Accent or theme.Input end)
	window:_paint(knob, "BackgroundColor3", function(theme) return element.Value and theme.Background or theme.Muted end)
	function element:Set(value, silent)
		assert(type(value) == "boolean", "Toggle value must be boolean")
		if self._destroyed then return self end
		local changed = self.Value ~= value
		self:_value(value, true)
		window:_tween(track, { BackgroundColor3 = value and window.Theme.Accent or window.Theme.Input })
		window:_tween(knob, { Position = UDim2.fromOffset(value and 22 or 4, 4), BackgroundColor3 = value and window.Theme.Background or window.Theme.Muted }, 0.22)
		if changed and not silent then callback(self, self.Callback, value) end
		return self
	end
	connect(element, hit.Activated, function() if not element.Disabled then element:Set(not element.Value) end end)
	element:Set(options.Default == true, true)
	return finishElement(element, options)
end

function Tab:AddSlider(options)
	options = options or {}
	local min, max, step = options.Min or 0, options.Max or 100, options.Step or 1
	assert(type(min) == "number" and type(max) == "number" and max > min and min > -math.huge and max < math.huge, "Slider requires finite Min < Max")
	assert(type(step) == "number" and step > 0 and step < math.huge, "Slider Step must be finite and positive")
	local element = self:_element(options, "Slider", 94)
	local window = self._window
	element.Min, element.Max, element.Step = min, max, step
	local valueLabel = window:_text(element.Frame, "", 13, { Position = UDim2.new(1, -110, 0, 17), Size = UDim2.fromOffset(94, 20), TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamMedium })
	window:_paint(valueLabel, "TextColor3", "Accent")
	local track = make("Frame", { BorderSizePixel = 0, Position = UDim2.new(0, 17, 1, -27), Size = UDim2.new(1, -34, 0, 5) }, element.Frame)
	round(track, 6); window:_paint(track, "BackgroundColor3", "Input")
	local fill = make("Frame", { BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, track)
	round(fill, 6); window:_paint(fill, "BackgroundColor3", "Accent")
	local knob = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14), BorderSizePixel = 0 }, track)
	round(knob, 14); window:_paint(knob, "BackgroundColor3", "Accent"); window:_stroke(knob, "Background")
	local hit = make("TextButton", { BackgroundTransparency = 1, Text = "", Position = UDim2.fromOffset(0, -13), Size = UDim2.new(1, 0, 0, 31), AutoButtonColor = false }, track)
	local decimals = math.clamp(math.ceil(-math.log10(step)) + 2, 0, 8)
	local function normalize(value)
		assert(type(value) == "number" and value == value and math.abs(value) < math.huge, "Slider value must be finite")
		value = math.clamp(value, min, max)
		if value == max then return max end
		local snapped = min + math.floor((value - min) / step + 0.5) * step
		return math.clamp(tonumber(string.format("%." .. decimals .. "f", snapped)), min, max)
	end
	element._validate = normalize
	function element:Set(value, silent)
		value = normalize(value)
		if self._destroyed then return self end
		local changed = self.Value ~= value
		self:_value(value, true)
		local alpha = (value - min) / (max - min)
		window:_tween(fill, { Size = UDim2.fromScale(alpha, 1) }, 0.09)
		window:_tween(knob, { Position = UDim2.fromScale(alpha, 0.5) }, 0.09)
		valueLabel.Text = tostring(value) .. tostring(options.Suffix or "")
		if changed and not silent then callback(self, self.Callback, value) end
		return self
	end
	bindDrag(element, hit, nil, function(pos)
		if track.AbsoluteSize.X <= 0 then return end
		local alpha = math.clamp((pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		element:Set(min + (max - min) * alpha)
	end)
	element:Set(options.Default or min, true)
	return finishElement(element, options)
end

